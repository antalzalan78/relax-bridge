  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "@js-temporal/polyfill": "^0.5.1",
    "astro": "^7.1.6",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "private": true,
