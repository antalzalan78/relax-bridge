# PostgreSQL connection string. Use the provider's pooled/serverless URL on Vercel.
DATABASE_URL=postgresql://user:password@host:5432/relax_bridge?sslmode=require

# Single administrator account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value

# Used only to hash rate-limit identifiers. Generate a long random value.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional. Defaults to Europe/Amsterdam.
BOOKING_TIME_ZONE=Europe/Amsterdam

# Transactional booking emails via Resend. Keep the API key secret.
RESEND_API_KEY=re_replace-with-resend-api-key
BOOKING_EMAIL_FROM="Relax Bridge <info@relaxbridge.nl>"
BOOKING_OWNER_EMAIL=info@relaxbridge.nl

# Full studio address shown in customer confirmation emails.
BOOKING_STUDIO_ADDRESS="Relax Bridge studio, Tilburg"

# Protects the Vercel retry endpoint. Generate at least 32 random characters.
CRON_SECRET=replace-with-at-least-32-random-characters
