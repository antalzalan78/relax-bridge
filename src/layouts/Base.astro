---
import { bookingPath, localeTags, type Locale } from '../data/site';
import { t } from '../i18n';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import BotanicalBackdrop from '../components/BotanicalBackdrop.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternates: Partial<Record<Locale, string>>;
  jsonLd?: Record<string, unknown>[];
}

const { locale, title, description, path, alternates, jsonLd } = Astro.props;
const d = t(locale);
const bookingHref = bookingPath(locale);
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo
      locale={locale}
      title={title}
      description={description}
      path={path}
      alternates={alternates}
      jsonLd={jsonLd}
    />
  </head>
  <body class:list={{ 'has-mobile-booking': path !== bookingHref }}>
    <a class="skip-link" href="#main">{d.accessibility.skipToContent}</a>
    <Header locale={locale} alternates={alternates} />
    <BotanicalBackdrop />
    <main id="main">
      <slot />
    </main>
    {path !== bookingHref && (
      <nav class="mobile-booking-dock" aria-label={d.service.bookCta}>
        <a class="mobile-booking" href={bookingHref}>
          <span>{d.service.bookCta}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </nav>
    )}
    <Footer locale={locale} />
  </body>
</html>
