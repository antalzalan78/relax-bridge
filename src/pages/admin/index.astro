---
import { Temporal } from '@js-temporal/polyfill';
import { z } from 'zod';
import { getAdminSession } from '../../lib/server/admin-auth';
import {
  addAvailabilityException,
  addAvailabilityRule,
  addManualCalendarBlock,
  cancelBooking,
  cancelManualCalendarBlock,
  deleteAvailabilityException,
  deleteAvailabilityRule,
  getBookingSettings,
  listAvailabilityExceptions,
  listAvailabilityRules,
  listBookings,
  listManualCalendarBlocks,
  ManualBlockConflictError,
  updateAvailabilityRuleMonths,
} from '../../lib/server/booking-repository';
import { assertSameOrigin } from '../../lib/server/security';
import { dispatchPendingBookingEmails, retryBookingEmails } from '../../lib/server/booking-email';
import { localDayInstantRange, resolveOpenWindows } from '../../lib/booking/availability';
import {
  getGoogleCalendarStatus,
  listGoogleCalendarBusy,
  listWritableGoogleCalendars,
  safelyRefreshGoogleCalendarBusy,
  safelyRemoveGoogleCalendarEntity,
  safelySyncGoogleCalendarEntity,
  selectGoogleCalendar,
  syncAllToGoogleCalendar,
} from '../../lib/server/google-calendar';
import AdminHeader from '../../components/AdminHeader.astro';
import '../../styles/global.css';

export const prerender = false;

const session = await getAdminSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const settings = await getBookingSettings();
const today = Temporal.Now.zonedDateTimeISO(settings.timeZone).toPlainDate();
const view = Astro.url.searchParams.get('view') === 'month' ? 'month' : 'week';
const requestedWeek = Astro.url.searchParams.get('week');
let selected = today;
try {
  if (requestedWeek) selected = Temporal.PlainDate.from(requestedWeek);
} catch {}
const weekStart = selected.subtract({ days: selected.dayOfWeek - 1 });
const weekEnd = weekStart.add({ days: 7 });
const previousWeek = weekStart.subtract({ days: 7 }).toString();
const nextWeek = weekStart.add({ days: 7 }).toString();
const requestedMonth = Astro.url.searchParams.get('month');
let monthStart = selected.with({ day: 1 });
try {
  if (requestedMonth && /^\d{4}-\d{2}$/.test(requestedMonth)) {
    monthStart = Temporal.PlainDate.from(`${requestedMonth}-01`);
  }
} catch {}
const monthKey = monthStart.toString().slice(0, 7);
const previousMonth = monthStart.subtract({ months: 1 }).toString().slice(0, 7);
const nextMonth = monthStart.add({ months: 1 }).toString().slice(0, 7);
const monthGridStart = monthStart.subtract({ days: monthStart.dayOfWeek - 1 });
const lastDayOfMonth = monthStart.add({ months: 1 }).subtract({ days: 1 });
const monthGridEnd = lastDayOfMonth.add({ days: 8 - lastDayOfMonth.dayOfWeek });
const periodStart = view === 'month' ? monthGridStart : weekStart;
const periodEnd = view === 'month' ? monthGridEnd : weekEnd;
const currentQuery = view === 'month'
  ? `view=month&month=${monthKey}`
  : `week=${weekStart}${requestedMonth ? `&month=${monthKey}` : ''}`;
let manualBlockError: string | null = null;
let manualDraft: Record<string, string> = {};
let ruleError: string | null = null;
let ruleDraft: Record<string, string> = {};
let submittedAction = '';

const selectedRuleMonths = (form: Record<string, FormDataEntryValue>): string[] => {
  const scope = z.enum(['always', 'months']).parse(form.scope || 'always');
  if (scope === 'always') return [];
  const value = z.string().max(400).parse(form.months || '');
  const months = value.split(',').map((month) => month.trim()).filter(Boolean);
  if (!months.length) throw new Error('Válassz legalább egy hónapot.');
  return months;
};

if (Astro.request.method === 'POST') {
  try {
    assertSameOrigin(Astro.request);
    const form = Object.fromEntries(await Astro.request.formData());
    const action = String(form.action || '');
    submittedAction = action;

    if (action === 'add_rule') {
      ruleDraft = Object.fromEntries(Object.entries(form).map(([key, value]) => [key, String(value)]));
      const input = z.object({
        weekday: z.coerce.number().int().min(1).max(7),
        startTime: z.string().regex(/^\d{2}:\d{2}$/),
        endTime: z.string().regex(/^\d{2}:\d{2}$/),
      }).parse(form);
      if (input.startTime >= input.endTime) throw new Error('Invalid time range');
      const ids = await addAvailabilityRule({ ...input, months: selectedRuleMonths(form) });
      for (const id of ids) await safelySyncGoogleCalendarEntity('availability_rule', id);
    } else if (action === 'update_rule_months') {
      ruleDraft = Object.fromEntries(Object.entries(form).map(([key, value]) => [key, String(value)]));
      const { id } = z.object({ id: z.uuid() }).parse(form);
      const { syncIds, removedIds } = await updateAvailabilityRuleMonths(id, selectedRuleMonths(form));
      for (const removedId of removedIds) await safelyRemoveGoogleCalendarEntity('availability_rule', removedId);
      for (const syncId of syncIds) await safelySyncGoogleCalendarEntity('availability_rule', syncId);
    } else if (action === 'delete_rule') {
      const { id } = z.object({ id: z.uuid() }).parse(form);
      const ids = await deleteAvailabilityRule(id);
      for (const removedId of ids) await safelyRemoveGoogleCalendarEntity('availability_rule', removedId);
    } else if (action === 'add_exception') {
      const input = z.object({
        day: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
        kind: z.enum(['open', 'blocked']),
        startTime: z.string().optional(),
        endTime: z.string().optional(),
        reason: z.string().trim().max(200).optional(),
        allDay: z.string().optional(),
      }).parse(form);
      const allDay = input.allDay === 'on';
      const startTime = allDay ? undefined : input.startTime || undefined;
      const endTime = allDay ? undefined : input.endTime || undefined;
      if ((!startTime && endTime) || (startTime && !endTime) || (startTime && endTime && startTime >= endTime)) {
        throw new Error('Invalid exception range');
      }
      if (input.kind === 'open' && (!startTime || !endTime)) {
        throw new Error('Open exceptions require a time range');
      }
      const id = await addAvailabilityException({ ...input, startTime, endTime });
      await safelySyncGoogleCalendarEntity('availability_exception', id);
    } else if (action === 'delete_exception') {
      const { id } = z.object({ id: z.uuid() }).parse(form);
      await safelyRemoveGoogleCalendarEntity('availability_exception', id);
      await deleteAvailabilityException(id);
    } else if (action === 'cancel_booking') {
      const { id } = z.object({ id: z.uuid() }).parse(form);
      if (await cancelBooking(id)) {
        await safelyRemoveGoogleCalendarEntity('booking', id);
        try {
          await dispatchPendingBookingEmails({ bookingId: id, limit: 1 });
        } catch (error) {
          console.error('Cancellation email dispatch failed; queued for retry', { bookingId: id, error });
        }
      }
    } else if (action === 'retry_booking_emails') {
      const { id } = z.object({ id: z.uuid() }).parse(form);
      await retryBookingEmails(id);
    } else if (action === 'add_manual_block') {
      manualDraft = Object.fromEntries(Object.entries(form).map(([key, value]) => [key, String(value)]));
      const input = z.object({
        day: z.iso.date(),
        startTime: z.string().regex(/^\d{2}:\d{2}$/),
        durationMinutes: z.coerce.number().int().min(15).max(240),
        category: z.enum(['studio', 'home']),
        guestName: z.string().trim().max(120).optional(),
        note: z.string().trim().max(500).optional(),
        applyStandardBuffer: z.string().optional(),
      }).parse(form);
      const startRange = localDayInstantRange(input.day, settings.timeZone);
      const nextRange = localDayInstantRange(
        Temporal.PlainDate.from(input.day).add({ days: 1 }).toString(), settings.timeZone,
      );
      await safelyRefreshGoogleCalendarBusy({ start: startRange.start, end: nextRange.end });
      const id = await addManualCalendarBlock({
        day: input.day, startTime: input.startTime, durationMinutes: input.durationMinutes,
        category: input.category, guestName: input.guestName, note: input.note,
        applyStandardBuffer: input.applyStandardBuffer === 'on',
      });
      await safelySyncGoogleCalendarEntity('manual_block', id);
    } else if (action === 'cancel_manual_block') {
      const { id } = z.object({ id: z.uuid() }).parse(form);
      if (await cancelManualCalendarBlock(id)) {
        await safelyRemoveGoogleCalendarEntity('manual_block', id);
      }
    } else if (action === 'select_google_calendar') {
      const { calendarId } = z.object({
        calendarId: z.string().trim().min(1).max(500),
      }).parse(form);
      const calendars = await listWritableGoogleCalendars();
      const calendar = calendars.find((item) => item.id === calendarId);
      if (!calendar) throw new Error('The selected Google Calendar is not writable.');
      await selectGoogleCalendar({
        calendarId: calendar.id,
        calendarSummary: calendar.summary,
      });
    } else if (action === 'sync_google_calendar') {
      await syncAllToGoogleCalendar();
    }
    return Astro.redirect(`/admin?${currentQuery}${action === 'add_manual_block' ? '&manual=saved' : ''}`, 303);
  } catch (error) {
    if (error instanceof Response) return error;
    console.error('Admin action failed', error);
    if (submittedAction === 'add_rule' || submittedAction === 'update_rule_months') {
      ruleError = error instanceof Error && error.message === 'Válassz legalább egy hónapot.'
        ? error.message
        : 'A heti idősáv nem menthető. Ellenőrizd az időpontot és a kiválasztott hónapokat.';
    } else if (submittedAction === 'add_manual_block') {
      manualBlockError = error instanceof ManualBlockConflictError
        ? error.message
        : error instanceof Error && (
          error.message === 'Múltbeli időpont nem rögzíthető.' ||
          error.message === 'A kezdés és az időtartam a foglalási időközhöz igazodjon.'
        ) ? error.message : 'A blokk nem menthető. Ellenőrizd a megadott dátumot és időtartamot.';
    } else {
      return new Response('A módosítás nem menthető. Ellenőrizd a megadott adatokat.', { status: 400 });
    }
  }
}

const startInstant = periodStart.toZonedDateTime({
  timeZone: settings.timeZone,
  plainTime: Temporal.PlainTime.from('00:00'),
}).toInstant().toString();
const endInstant = periodEnd.toZonedDateTime({
  timeZone: settings.timeZone,
  plainTime: Temporal.PlainTime.from('00:00'),
}).toInstant().toString();

await safelyRefreshGoogleCalendarBusy({ start: startInstant, end: endInstant });
const [rules, exceptions, bookings, googleBusy, manualBlocks] = await Promise.all([
  listAvailabilityRules(),
  listAvailabilityExceptions(periodStart.toString(), periodEnd.subtract({ days: 1 }).toString()),
  listBookings(startInstant, endInstant),
  listGoogleCalendarBusy({ start: startInstant, end: endInstant }),
  listManualCalendarBlocks(startInstant, endInstant),
]);

const weekdays = ['Hétfő', 'Kedd', 'Szerda', 'Csütörtök', 'Péntek', 'Szombat', 'Vasárnap'];
const formattedMonth = (key: string) => new Intl.DateTimeFormat('hu-HU', {
  year: 'numeric', month: 'long', timeZone: 'UTC',
}).format(new Date(`${key}-01T12:00:00Z`));
const ruleGroups = new Map<string, {
  id: string;
  weekday: number;
  startTime: string;
  endTime: string;
  months: string[];
}>();
for (const rule of rules) {
  const groupKey = String(rule.series_id || rule.id);
  let group = ruleGroups.get(groupKey);
  if (!group) {
    group = {
      id: String(rule.id), weekday: Number(rule.weekday),
      startTime: String(rule.start_time).slice(0, 5),
      endTime: String(rule.end_time).slice(0, 5), months: [],
    };
    ruleGroups.set(groupKey, group);
  }
  if (rule.valid_from) group.months.push(String(rule.valid_from).slice(0, 7));
}
for (const group of ruleGroups.values()) group.months.sort();
const localDate = (value: unknown) =>
  value instanceof Date ? value.toISOString().slice(0, 10) : String(value).slice(0, 10);
const localBooking = (value: unknown) =>
  Temporal.Instant.from(value instanceof Date ? value.toISOString() : String(value))
    .toZonedDateTimeISO(settings.timeZone);
const days = Array.from(
  { length: periodStart.until(periodEnd).days },
  (_, index) => periodStart.add({ days: index }),
);
const bookingsByDay = new Map(days.map((day) => [day.toString(), [] as any[]]));
for (const booking of bookings) {
  const key = localBooking(booking.starts_at).toPlainDate().toString();
  bookingsByDay.get(key)?.push(booking);
}
const exceptionsByDay = new Map(days.map((day) => [day.toString(), [] as any[]]));
for (const exception of exceptions) exceptionsByDay.get(localDate(exception.day))?.push(exception);
const shortTime = (value: unknown) => String(value).slice(0, 5);
const openWindowsByDay = new Map(days.map((day) => {
  const date = day.toString();
  const dayExceptions = exceptionsByDay.get(date) || [];
  const baseWindows = rules
    .filter((rule) =>
      rule.active !== false &&
      Number(rule.weekday) === day.dayOfWeek &&
      (!rule.valid_from || localDate(rule.valid_from) <= date) &&
      (!rule.valid_until || localDate(rule.valid_until) >= date)
    )
    .map((rule) => ({ start: shortTime(rule.start_time), end: shortTime(rule.end_time) }));
  const additionalOpenWindows = dayExceptions
    .filter((exception) => exception.kind === 'open' && exception.start_time && exception.end_time)
    .map((exception) => ({ start: shortTime(exception.start_time), end: shortTime(exception.end_time) }));
  const blockedWindows = dayExceptions
    .filter((exception) => exception.kind === 'blocked' && exception.start_time && exception.end_time)
    .map((exception) => ({ start: shortTime(exception.start_time), end: shortTime(exception.end_time) }));
  const blockAllDay = dayExceptions.some((exception) =>
    exception.kind === 'blocked' && !exception.start_time && !exception.end_time
  );

  return [date, resolveOpenWindows({ baseWindows, additionalOpenWindows, blockedWindows, blockAllDay })] as const;
}));
const emailStatusLabel = (value: unknown) => ({
  pending: 'függőben',
  sending: 'küldés alatt',
  sent: 'elküldve',
  failed: 'sikertelen',
  suppressed: 'nem küldtük el',
}[String(value)] || 'nem volt ütemezve');
const googleNotice = ({
  connected: 'A Google-fiók csatlakoztatva. Válaszd ki a használni kívánt naptárt.',
  denied: 'A Google Calendar hozzáférése nem lett engedélyezve.',
  'invalid-state': 'A Google-kapcsolat időkorlátja lejárt. Indítsd el újra a csatlakoztatást.',
  'connection-failed': 'A Google Calendar csatlakoztatása nem sikerült.',
  'not-configured': 'A Google Calendar környezeti beállításai még hiányoznak.',
} as Record<string, string>)[Astro.url.searchParams.get('google') || ''];
let googleStatus = await getGoogleCalendarStatus();
let googleCalendars: Awaited<ReturnType<typeof listWritableGoogleCalendars>> = [];
if (googleStatus.configured && googleStatus.connected) {
  try {
    googleCalendars = await listWritableGoogleCalendars();
  } catch (error) {
    console.error('Google Calendar list could not be loaded', error);
  }
}
const googleBusyByDay = new Map(days.map((day) => {
  const dayStart = day.toZonedDateTime({
    timeZone: settings.timeZone,
    plainTime: Temporal.PlainTime.from('00:00'),
  }).toInstant().epochMilliseconds;
  const dayEnd = day.add({ days: 1 }).toZonedDateTime({
    timeZone: settings.timeZone,
    plainTime: Temporal.PlainTime.from('00:00'),
  }).toInstant().epochMilliseconds;
  return [day.toString(), googleBusy.filter((busy) =>
    new Date(busy.starts_at).getTime() < dayEnd &&
    new Date(busy.ends_at).getTime() > dayStart
  )] as const;
}));
const manualBlocksByDay = new Map(days.map((day) => {
  const range = localDayInstantRange(day.toString(), settings.timeZone);
  const start = Temporal.Instant.from(range.start).epochMilliseconds;
  const end = Temporal.Instant.from(range.end).epochMilliseconds;
  return [day.toString(), manualBlocks.filter((block) =>
    new Date(block.starts_at).getTime() < end &&
    new Date(block.ends_at).getTime() > start
  )] as const;
}));
const manualStartTimes = (start: string, end: string) => {
  const minutes = (value: string) => Number(value.slice(0, 2)) * 60 + Number(value.slice(3, 5));
  const labels: string[] = [];
  const first = Math.ceil(minutes(start) / settings.slotIntervalMinutes) * settings.slotIntervalMinutes;
  for (let value = first; value < minutes(end); value += settings.slotIntervalMinutes) {
    labels.push(`${String(Math.floor(value / 60)).padStart(2, '0')}:${String(value % 60).padStart(2, '0')}`);
  }
  return labels;
};
const busyTimeOnDay = (value: unknown, day: Temporal.PlainDate, edge: 'start' | 'end') => {
  const local = localBooking(value);
  const localDay = local.toPlainDate().toString();
  if (edge === 'start' && localDay < day.toString()) return '00:00';
  if (edge === 'end' && localDay > day.toString()) return '24:00';
  return `${String(local.hour).padStart(2, '0')}:${String(local.minute).padStart(2, '0')}`;
};
const syncTime = (value: unknown) => value
  ? new Intl.DateTimeFormat('hu-HU', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: settings.timeZone,
    }).format(new Date(value as string | number | Date))
  : 'még nem történt';
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Foglalási admin — Relax Bridge</title>
  </head>
  <body class="admin-page">
    <AdminHeader email={session.email} active="bookings" />

    <main class="admin-wrap admin-main">
      <section class="admin-title">
        <div>
          <span class="eyebrow">Egy közös naptár</span>
          <h1>Foglalások és szabad idők</h1>
          <div class="booking-legend" aria-label="Foglalástípusok jelmagyarázata">
            <span><i class="booking-legend__swatch booking-legend__swatch--open"></i>Foglalható idősáv</span>
            <span><i class="booking-legend__swatch booking-legend__swatch--studio"></i>Stúdió</span>
            <span><i class="booking-legend__swatch booking-legend__swatch--home"></i>Home service</span>
            <span><i class="booking-legend__swatch booking-legend__swatch--manual"></i>Manuális blokk</span>
            <span><i class="booking-legend__swatch booking-legend__swatch--google"></i>Google Naptárban foglalt</span>
          </div>
        </div>
        <div class="calendar-controls">
          <nav class="view-switch" aria-label="Naptárnézet">
            <a href={`/admin?week=${view === 'month' ? monthStart.toString() : weekStart.toString()}${view === 'month' || requestedMonth ? `&month=${monthKey}` : ''}`} aria-current={view === 'week' ? 'page' : undefined}>Heti nézet</a>
            <a href={`/admin?view=month&month=${view === 'week' && !requestedMonth ? weekStart.add({ days: 3 }).toString().slice(0, 7) : monthKey}`} aria-current={view === 'month' ? 'page' : undefined}>Havi nézet</a>
          </nav>
          {view === 'week' ? (
            <nav class="week-nav" aria-label="Hétválasztó">
              <a href={`/admin?week=${previousWeek}`} aria-label="Előző hét">&larr;</a>
              <strong>{weekStart.toLocaleString('hu-HU', { day: 'numeric', month: 'long' })} – {weekEnd.subtract({ days: 1 }).toLocaleString('hu-HU', { day: 'numeric', month: 'long', year: 'numeric' })}</strong>
              <a href={`/admin?week=${nextWeek}`} aria-label="Következő hét">&rarr;</a>
            </nav>
          ) : (
            <nav class="week-nav" aria-label="Hónapválasztó">
              <a href={`/admin?view=month&month=${previousMonth}`} aria-label="Előző hónap">&larr;</a>
              <strong>{monthStart.toLocaleString('hu-HU', { year: 'numeric', month: 'long' })}</strong>
              <a href={`/admin?view=month&month=${nextMonth}`} aria-label="Következő hónap">&rarr;</a>
            </nav>
          )}
        </div>
      </section>

      {Astro.url.searchParams.get('manual') === 'saved' && <p class="manual-notice" role="status">A manuális időpontot rögzítettem; az érintett időszak nem foglalható online.</p>}

      {view === 'week' ? (
      <section class="calendar-grid" aria-label="Heti foglalások">
        {days.map((day, index) => {
          const dayBookings = bookingsByDay.get(day.toString()) || [];
          const dayExceptions = exceptionsByDay.get(day.toString()) || [];
          const openWindows = openWindowsByDay.get(day.toString()) || [];
          const googleBusyWindows = googleBusyByDay.get(day.toString()) || [];
          const dayManualBlocks = manualBlocksByDay.get(day.toString()) || [];
          return (
            <article class:list={['calendar-day', { 'calendar-day--today': day.equals(today) }]}>
              <header>
                <span>{weekdays[index]}</span>
                <strong>{day.day}</strong>
              </header>
              {openWindows.length > 0 && (
                <div class="open-window-list" aria-label="Foglalható idősávok">
                  {openWindows.map((window) => (
                    <div class="open-window">
                      <span>Foglalható</span>
                      <strong>{window.start}–{window.end}</strong>
                    </div>
                  ))}
                </div>
              )}
              <details class="manual-start-picker">
                <summary>+ Manuális időpont / blokk</summary>
                <div class="manual-start-picker__times">
                  {openWindows.flatMap((window) => manualStartTimes(window.start, window.end)).map((time) => (
                    <button type="button" data-manual-date={day.toString()} data-manual-time={time}>{time}</button>
                  ))}
                  <button class="manual-start-picker__other" type="button" data-manual-date={day.toString()} data-manual-time="10:00">Más kezdés…</button>
                </div>
              </details>
              {dayExceptions.map((exception) => (
                <div class:list={['exception-chip', `exception-chip--${exception.kind}`]}>
                  <span>{exception.kind === 'blocked' ? 'Zárva' : 'Extra nyitva'}</span>
                  <small>{exception.start_time ? `${shortTime(exception.start_time)}–${shortTime(exception.end_time)}` : 'egész nap'}{exception.reason ? ` · ${exception.reason}` : ''}</small>
                </div>
              ))}
              {googleBusyWindows.map((busy) => {
                return (
                  <div class="google-busy-chip">
                    <span>Google Naptárban foglalt</span>
                    <strong>
                      {busyTimeOnDay(busy.starts_at, day, 'start')}
                      –{busyTimeOnDay(busy.ends_at, day, 'end')}
                    </strong>
                  </div>
                );
              })}
              {dayManualBlocks.map((block) => (
                <div class="manual-block-chip">
                  <span>{block.guest_name || 'Manuális blokk'}</span>
                  <strong>{busyTimeOnDay(block.starts_at, day, 'start')}–{busyTimeOnDay(block.ends_at, day, 'end')}</strong>
                  <small>{block.service_category === 'home' ? 'Home Service' : 'Stúdió'} · {block.duration_minutes} perc{Number(block.buffer_minutes) ? ` + ${block.buffer_minutes} perc buffer` : ' · buffer nélkül'}</small>
                  {block.note && <small>{block.note}</small>}
                  <form method="post" onsubmit="return confirm('Biztosan felszabadítod ezt a manuális időpontot?')">
                    <input type="hidden" name="action" value="cancel_manual_block" />
                    <input type="hidden" name="id" value={block.id} />
                    <button type="submit">Felszabadítás</button>
                  </form>
                </div>
              ))}
              <div class="day-bookings">
                {dayBookings.length === 0 && dayManualBlocks.length === 0 && <p class="empty-day">Nincs foglalás</p>}
                {dayBookings.map((booking) => {
                  const start = localBooking(booking.starts_at);
                  const end = localBooking(booking.ends_at);
                  return (
                    <details class:list={[
                      'booking-item',
                      `booking-item--${booking.service_category}`,
                      { 'booking-item--cancelled': booking.status === 'cancelled' },
                    ]}>
                      <summary>
                        <strong>{String(start.hour).padStart(2, '0')}:{String(start.minute).padStart(2, '0')}</strong>
                        <span>{booking.customer_name}</span>
                        <small>{booking.service_category === 'home' ? 'Otthoni' : 'Stúdió'}</small>
                      </summary>
                      <div>
                        <p>{booking.service_title} · {booking.duration_minutes} perc · € {Number(booking.price_eur)}</p>
                        <p>{String(start.hour).padStart(2, '0')}:{String(start.minute).padStart(2, '0')}–{String(end.hour).padStart(2, '0')}:{String(end.minute).padStart(2, '0')}</p>
                        <p><a href={`tel:${booking.customer_phone}`}>{booking.customer_phone}</a><br /><a href={`mailto:${booking.customer_email}`}>{booking.customer_email}</a></p>
                        {(booking.home_address || booking.home_postal_code) && (
                          <p><strong>Cím:</strong> {[booking.home_address, booking.home_postal_code].filter(Boolean).join(', ')}</p>
                        )}
                        {booking.notes && <p><strong>Megjegyzés:</strong> {booking.notes}</p>}
                        <p class="reference">{booking.reference}</p>
                        {booking.status === 'cancelled' ? (
                          <div class="email-delivery" aria-label="Lemondási e-mail kézbesítése">
                            <span class:list={{ 'email-delivery--sent': booking.cancellation_email_status === 'sent' }}>
                              Lemondás az ügyfélnek: {emailStatusLabel(booking.cancellation_email_status)}
                            </span>
                          </div>
                        ) : (booking.customer_email_status || booking.owner_email_status) && (
                          <div class="email-delivery" aria-label="E-mail-kézbesítés">
                            <span class:list={{ 'email-delivery--sent': booking.customer_email_status === 'sent' }}>
                              Ügyfél: {emailStatusLabel(booking.customer_email_status)}
                            </span>
                            <span class:list={{ 'email-delivery--sent': booking.owner_email_status === 'sent' }}>
                              Saját: {emailStatusLabel(booking.owner_email_status)}
                            </span>
                          </div>
                        )}
                        {(booking.status === 'cancelled'
                          ? booking.cancellation_email_status === 'pending' || booking.cancellation_email_status === 'failed'
                          : booking.customer_email_status === 'pending' || booking.customer_email_status === 'failed' ||
                            booking.owner_email_status === 'pending' || booking.owner_email_status === 'failed') ? (
                          <form method="post">
                            <input type="hidden" name="action" value="retry_booking_emails" />
                            <input type="hidden" name="id" value={booking.id} />
                            <button class="retry-link" type="submit">
                              {booking.status === 'cancelled' ? 'Lemondási e-mail újrapróbálása' : 'E-mailek újrapróbálása'}
                            </button>
                          </form>
                        ) : null}
                        {booking.status === 'confirmed' ? (
                          <form method="post" onsubmit="return confirm('Biztosan lemondod ezt a foglalást?')">
                            <input type="hidden" name="action" value="cancel_booking" />
                            <input type="hidden" name="id" value={booking.id} />
                            <button class="danger-link" type="submit">Foglalás lemondása</button>
                          </form>
                        ) : <span class="cancelled-label">Lemondva</span>}
                      </div>
                    </details>
                  );
                })}
              </div>
            </article>
          );
        })}
      </section>
      ) : (
      <section class="month-calendar" aria-label="Havi foglalások">
        <div class="month-grid">
          {weekdays.map((weekday, index) => (
            <span class="month-weekday">
              <span class="month-weekday__full">{weekday}</span>
              <span class="month-weekday__short">{['H', 'K', 'Sze', 'Cs', 'P', 'Szo', 'V'][index]}</span>
            </span>
          ))}
          {days.map((day) => {
            const date = day.toString();
            const dayBookings = bookingsByDay.get(date) || [];
            const dayExceptions = exceptionsByDay.get(date) || [];
            const openWindows = openWindowsByDay.get(date) || [];
            const googleBusyWindows = googleBusyByDay.get(date) || [];
            const dayManualBlocks = manualBlocksByDay.get(date) || [];
            const dayWeek = day.subtract({ days: day.dayOfWeek - 1 }).toString();
            return (
              <a
                class:list={['month-day', {
                  'month-day--today': day.equals(today),
                  'month-day--outside': day.month !== monthStart.month || day.year !== monthStart.year,
                }]}
                href={`/admin?week=${dayWeek}&month=${date.slice(0, 7)}`}
                aria-label={`${day.toLocaleString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' })}: ${openWindows.length} nyitott idősáv, ${dayBookings.length} foglalás, ${dayManualBlocks.length} manuális blokk, ${dayExceptions.length} egyedi módosítás, ${googleBusyWindows.length} Google-foglaltság. Részletek a heti nézetben.`}
              >
                <span class="month-day__number">{day.day}</span>
                <span class="month-day__items">
                  {openWindows.map((window) => (
                    <span class="month-chip month-chip--open" title={`Foglalható ${window.start}–${window.end}`}>
                      <span class="month-chip__label">Foglalható </span>{window.start}–{window.end}
                    </span>
                  ))}
                  {dayExceptions.map((exception) => (
                    <span class:list={['month-chip', `month-chip--${exception.kind}`]}>
                      {exception.kind === 'blocked' ? 'Zárva' : 'Extra nyitva'}
                      <span class="month-chip__detail">{exception.start_time ? ` ${shortTime(exception.start_time)}–${shortTime(exception.end_time)}` : ' egész nap'}</span>
                    </span>
                  ))}
                  {googleBusyWindows.map((busy) => {
                    return <span class="month-chip month-chip--google" title="Google Naptárban foglalt">
                      <span class="month-chip__label">Google </span>
                      {busyTimeOnDay(busy.starts_at, day, 'start')}
                      –{busyTimeOnDay(busy.ends_at, day, 'end')}
                    </span>;
                  })}
                  {dayManualBlocks.map((block) => (
                    <span class="month-chip month-chip--manual" title={`${block.guest_name || 'Manuális blokk'} · ${block.duration_minutes} perc${Number(block.buffer_minutes) ? ` + ${block.buffer_minutes} perc buffer` : ''}`}>
                      {busyTimeOnDay(block.starts_at, day, 'start')}–{busyTimeOnDay(block.ends_at, day, 'end')}
                      <span class="month-chip__label"> {block.guest_name || 'Manuális blokk'}</span>
                    </span>
                  ))}
                  {dayBookings.map((booking) => {
                    const start = localBooking(booking.starts_at);
                    return <span class:list={['month-chip', `month-chip--${booking.service_category}`, { 'month-chip--cancelled': booking.status === 'cancelled' }]}>
                      {String(start.hour).padStart(2, '0')}:{String(start.minute).padStart(2, '0')}
                      <span class="month-chip__label"> {booking.customer_name}</span>
                    </span>;
                  })}
                </span>
              </a>
            );
          })}
        </div>
        <p class="month-hint">Kattints egy napra a foglalások részleteihez és a heti nézethez.</p>
      </section>
      )}

      <dialog id="manual-block-dialog" class="manual-block-dialog" open={Boolean(manualBlockError)} aria-labelledby="manual-block-title">
        <form method="post" class="manual-block-form">
          <input type="hidden" name="action" value="add_manual_block" />
          <div class="manual-block-dialog__head"><div><span class="eyebrow">Admin naptár</span><h2 id="manual-block-title">Manuális időpont / blokk</h2></div><button id="manual-block-close" type="button" aria-label="Ablak bezárása">×</button></div>
          <p>Névvel külső foglalásként, név nélkül lezárásként használhatod. Standard bufferrel ugyanazok a nyitvatartási, előfoglalási és ütközési szabályok érvényesek, mint a vendégoldalon. Ügyfélnek nem küld automatikus e-mailt.</p>
          {manualBlockError && <p class="manual-block-error" role="alert">{manualBlockError}</p>}
          <div class="manual-block-form__row">
            <label>Dátum<input name="day" type="date" value={manualDraft.day || selected.toString()} required /></label>
            <label>Kezdés<input name="startTime" type="time" step="900" value={manualDraft.startTime || '10:00'} required /></label>
          </div>
          <div class="manual-block-form__row">
            <label>Időtartam (perc)<input name="durationMinutes" type="number" min="15" max="240" step="15" value={manualDraft.durationMinutes || '60'} required /></label>
            <label>Típus<select name="category"><option value="studio" selected={manualDraft.category !== 'home'}>Studio Visit</option><option value="home" selected={manualDraft.category === 'home'}>Home Service</option></select></label>
          </div>
          <label>Vendég neve (opcionális)<input name="guestName" maxlength="120" value={manualDraft.guestName || ''} placeholder="pl. WhatsApp-foglalás" /></label>
          <label>Megjegyzés (opcionális)<input name="note" maxlength="500" value={manualDraft.note || ''} placeholder="pl. privát időpont" /></label>
          <label class="manual-block-form__check"><input name="applyStandardBuffer" type="checkbox" checked={Object.keys(manualDraft).length ? manualDraft.applyStandardBuffer === 'on' : true} /> Standard buffer alkalmazása</label>
          <p id="manual-block-preview" class="manual-block-preview" aria-live="polite"></p>
          <div class="manual-block-form__actions"><button type="button" id="manual-block-cancel" class="btn btn--outline">Mégse</button><button class="btn btn--primary" type="submit">Időpont rögzítése</button></div>
        </form>
      </dialog>

      <section class="admin-panels">
        <article class="admin-panel">
          <span class="panel-number">01</span>
          <h2>Heti nyitvatartás</h2>
          <p>Ismétlődő idősávok. Egy naphoz több sáv is felvehető. Az idősáv egész évben vagy csak a kiválasztott év–hónapokban lehet érvényes.</p>
          {ruleError && <p class="rule-error" role="alert">{ruleError}</p>}
          <form class="compact-form" method="post">
            <input type="hidden" name="action" value="add_rule" />
            <label>Nap
              <select name="weekday" required>{weekdays.map((day, index) => <option value={index + 1} selected={ruleDraft.weekday === String(index + 1)}>{day}</option>)}</select>
            </label>
            <label>Kezdés<input name="startTime" type="time" step="900" value={ruleDraft.startTime || ''} required /></label>
            <label>Vége<input name="endTime" type="time" step="900" value={ruleDraft.endTime || ''} required /></label>
            <div class="rule-month-selector wide-field" data-month-selector>
              <label>Érvényesség
                <select name="scope" data-month-scope>
                  <option value="always" selected={ruleDraft.scope !== 'months'}>Minden hónapban, folyamatosan</option>
                  <option value="months" selected={ruleDraft.scope === 'months'}>Csak kiválasztott hónapokban</option>
                </select>
              </label>
              <div class="rule-month-picker" data-month-picker hidden={ruleDraft.scope !== 'months'}>
                <label>Hónap hozzáadása<input type="month" data-month-input /></label>
                <button type="button" class="btn btn--outline" data-month-add>Hozzáadás</button>
                <div class="rule-month-chips" data-month-chips aria-live="polite"></div>
              </div>
              <input type="hidden" name="months" data-month-value value={ruleDraft.months || ''} />
            </div>
            <button class="btn btn--primary" type="submit">Idősáv hozzáadása</button>
          </form>
          <div class="rule-list">
            {ruleGroups.size === 0 && <p>Még nincs heti nyitvatartás beállítva.</p>}
            {Array.from(ruleGroups.values()).map((group) => {
              const editing = submittedAction === 'update_rule_months' && ruleDraft.id === group.id;
              const monthValues = editing ? ruleDraft.months || '' : group.months.join(',');
              const monthScope = editing ? ruleDraft.scope : group.months.length ? 'months' : 'always';
              return <div class="rule-row rule-row--availability">
                <div class="rule-row__content">
                  <span><strong>{weekdays[group.weekday - 1]}</strong> {group.startTime}–{group.endTime}</span>
                  <small>{group.months.length ? group.months.map(formattedMonth).join(', ') : 'Minden hónapban érvényes'}</small>
                  <details class="rule-month-editor" open={editing && Boolean(ruleError)}>
                    <summary>Hónapok módosítása</summary>
                    <form method="post" class="rule-month-edit-form">
                      <input type="hidden" name="action" value="update_rule_months" />
                      <input type="hidden" name="id" value={group.id} />
                      <div class="rule-month-selector" data-month-selector>
                        <label>Érvényesség
                          <select name="scope" data-month-scope>
                            <option value="always" selected={monthScope !== 'months'}>Minden hónapban, folyamatosan</option>
                            <option value="months" selected={monthScope === 'months'}>Csak kiválasztott hónapokban</option>
                          </select>
                        </label>
                        <div class="rule-month-picker" data-month-picker hidden={monthScope !== 'months'}>
                          <label>Hónap hozzáadása<input type="month" data-month-input /></label>
                          <button type="button" class="btn btn--outline" data-month-add>Hozzáadás</button>
                          <div class="rule-month-chips" data-month-chips aria-live="polite"></div>
                        </div>
                        <input type="hidden" name="months" data-month-value value={monthValues} />
                      </div>
                      <button class="btn btn--outline" type="submit">Hónapok mentése</button>
                    </form>
                  </details>
                </div>
                <form method="post">
                  <input type="hidden" name="action" value="delete_rule" />
                  <input type="hidden" name="id" value={group.id} />
                  <button class="icon-button" type="submit" aria-label={`${weekdays[group.weekday - 1]} ${group.startTime}–${group.endTime} idősáv törlése`} onclick="return confirm('Biztosan törlöd ezt a heti idősávot az összes kiválasztott hónapból?')">×</button>
                </form>
              </div>;
            })}
          </div>
        </article>

        <article class="admin-panel admin-panel--dark">
          <span class="panel-number">02</span>
          <h2>Egyedi nap módosítása</h2>
          <p>Zárj le egy napot vagy idősávot, illetve adj hozzá extra nyitvatartást.</p>
          <form class="compact-form" method="post">
            <input type="hidden" name="action" value="add_exception" />
            <label>Dátum<input name="day" type="date" value={view === 'month' ? monthStart.toString() : weekStart.toString()} required /></label>
            <label>Típus
              <select name="kind" required>
                <option value="blocked">Nem elérhető</option>
                <option value="open">Extra nyitva</option>
              </select>
            </label>
            <label>Kezdés<input name="startTime" type="time" step="900" /></label>
            <label>Vége<input name="endTime" type="time" step="900" /></label>
            <label class="checkbox-label"><input name="allDay" type="checkbox" /> Egész nap (csak lezárásnál)</label>
            <label class="wide-field">Megjegyzés<input name="reason" maxlength="200" placeholder="pl. szabadság" /></label>
            <button class="btn btn--light" type="submit">Módosítás hozzáadása</button>
          </form>
          <div class="rule-list">
            {exceptions.length === 0 && <p>A megjelenített időszakban nincs egyedi módosítás.</p>}
            {exceptions.map((exception) => (
              <div class="rule-row">
                <span><strong>{localDate(exception.day)}</strong> {exception.kind === 'blocked' ? 'zárva' : 'extra nyitva'} {exception.start_time ? `${shortTime(exception.start_time)}–${shortTime(exception.end_time)}` : 'egész nap'}</span>
                <form method="post">
                  <input type="hidden" name="action" value="delete_exception" />
                  <input type="hidden" name="id" value={exception.id} />
                  <button class="icon-button" type="submit" aria-label="Módosítás törlése">×</button>
                </form>
              </div>
            ))}
          </div>
        </article>
      </section>

      <section class="google-calendar-panel" aria-labelledby="google-calendar-title">
        <span class="panel-number">03</span>
        <div>
          <span class="eyebrow">Külső naptár</span>
          <h2 id="google-calendar-title">Google Calendar-szinkronizálás</h2>
          <p>
            A weboldalas foglalások és a megnyitott idősávok megjelennek a kiválasztott
            Google Naptárban. A Google Naptár foglalt eseményeit a weboldal automatikusan
            kizárja a foglalható időpontokból.
          </p>
          {googleNotice && <p class="google-notice">{googleNotice}</p>}
          {!googleStatus.configured ? (
            <p class="google-state google-state--pending">
              A technikai Google-kulcsok beállítása szükséges a csatlakoztatás előtt.
            </p>
          ) : !googleStatus.connected ? (
            <a class="btn btn--primary" href="/api/admin/google-calendar/connect">
              Google Naptár csatlakoztatása
            </a>
          ) : (
            <div class="google-calendar-controls">
              <p class="google-state google-state--connected">
                <strong>Google-fiók csatlakoztatva</strong>
                {googleStatus.calendarSummary
                  ? ` · Kiválasztott naptár: ${googleStatus.calendarSummary}`
                  : ' · Még nincs kiválasztott naptár.'}
              </p>
              <form class="google-calendar-form" method="post">
                <input type="hidden" name="action" value="select_google_calendar" />
                <label>Naptár
                  <select name="calendarId" required>
                    <option value="">Válassz naptárt</option>
                    {googleCalendars.map((calendar) => (
                      <option
                        value={calendar.id}
                        selected={calendar.id === googleStatus.calendarId}
                      >
                        {calendar.summary}{calendar.primary ? ' (elsődleges)' : ''}
                      </option>
                    ))}
                  </select>
                </label>
                <button class="btn btn--primary" type="submit">Naptár mentése</button>
              </form>
              {googleStatus.selected && (
                <form method="post">
                  <input type="hidden" name="action" value="sync_google_calendar" />
                  <button class="btn btn--outline" type="submit">Szinkronizálás most</button>
                </form>
              )}
              <dl class="google-sync-meta">
                <div><dt>Foglalások és nyitvatartás</dt><dd>{syncTime(googleStatus.lastOutboundSyncAt)}</dd></div>
                <div><dt>Google foglaltság</dt><dd>{syncTime(googleStatus.lastBusySyncAt)}</dd></div>
              </dl>
              {googleStatus.lastError && (
                <p class="google-error">Utolsó szinkronhiba: {googleStatus.lastError}</p>
              )}
            </div>
          )}
        </div>
      </section>
    </main>
    <script>
      const monthFormatter = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'long', timeZone: 'UTC' });
      for (const selector of document.querySelectorAll<HTMLElement>('[data-month-selector]')) {
        const form = selector.closest('form');
        const scope = selector.querySelector<HTMLSelectElement>('[data-month-scope]');
        const picker = selector.querySelector<HTMLElement>('[data-month-picker]');
        const input = selector.querySelector<HTMLInputElement>('[data-month-input]');
        const value = selector.querySelector<HTMLInputElement>('[data-month-value]');
        const chips = selector.querySelector<HTMLElement>('[data-month-chips]');
        const add = selector.querySelector<HTMLButtonElement>('[data-month-add]');
        if (!form || !scope || !picker || !input || !value || !chips || !add) continue;
        const months = new Set(value.value.split(',').filter((month) => /^\d{4}-(0[1-9]|1[0-2])$/.test(month)));
        const render = () => {
          picker.hidden = scope.value !== 'months';
          value.value = [...months].sort().join(',');
          chips.replaceChildren();
          for (const month of [...months].sort()) {
            const chip = document.createElement('span');
            chip.className = 'rule-month-chip';
            chip.append(monthFormatter.format(new Date(`${month}-01T12:00:00Z`)));
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = '×';
            remove.setAttribute('aria-label', `${month} eltávolítása`);
            remove.addEventListener('click', () => { months.delete(month); render(); });
            chip.append(remove);
            chips.append(chip);
          }
        };
        add.addEventListener('click', () => {
          if (!input.value) {
            input.setCustomValidity('Válassz hozzáadandó hónapot.');
            input.reportValidity();
            input.focus();
            return;
          }
          months.add(input.value);
          input.value = '';
          input.setCustomValidity('');
          render();
        });
        input.addEventListener('input', () => input.setCustomValidity(''));
        scope.addEventListener('change', render);
        form.addEventListener('submit', (event) => {
          if (scope.value === 'months' && months.size === 0) {
            event.preventDefault();
            input.setCustomValidity('Válassz legalább egy hónapot.');
            input.reportValidity();
          }
        });
        render();
      }

      const dialog = document.querySelector<HTMLDialogElement>('#manual-block-dialog');
      const form = dialog?.querySelector<HTMLFormElement>('form');
      if (dialog && form) {
        const day = form.elements.namedItem('day') as HTMLInputElement;
        const startTime = form.elements.namedItem('startTime') as HTMLInputElement;
        const duration = form.elements.namedItem('durationMinutes') as HTMLInputElement;
        const category = form.elements.namedItem('category') as HTMLSelectElement;
        const useBuffer = form.elements.namedItem('applyStandardBuffer') as HTMLInputElement;
        const preview = dialog.querySelector<HTMLElement>('#manual-block-preview');
        const updatePreview = () => {
          if (!preview || !startTime.value || !Number(duration.value)) return;
          const [hour, minute] = startTime.value.split(':').map(Number);
          const base = hour * 60 + minute;
          const massageEnd = base + Number(duration.value);
          const label = (value: number) => `${String(Math.floor(value / 60) % 24).padStart(2, '0')}:${String(value % 60).padStart(2, '0')}${value >= 1440 ? ' (másnap)' : ''}`;
          preview.textContent = useBuffer.checked
            ? `${startTime.value}–${label(massageEnd)} ${category.value === 'home' ? 'Home Service' : 'Studio Visit'} · következő Stúdió legkorábban ${label(massageEnd + 30)}, Home Service ${label(massageEnd + 120)} (ha nincs más ütközés).`
            : `${startTime.value}–${label(massageEnd)} pontos idősávzárás · buffer nélkül.`;
        };
        for (const control of [startTime, duration, category, useBuffer]) control.addEventListener('change', updatePreview);
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-manual-date]')) {
          button.addEventListener('click', () => {
            day.value = button.dataset.manualDate || '';
            startTime.value = button.dataset.manualTime || '10:00';
            updatePreview();
            dialog.showModal();
            startTime.focus();
          });
        }
        const close = () => dialog.close();
        dialog.querySelector('#manual-block-close')?.addEventListener('click', close);
        dialog.querySelector('#manual-block-cancel')?.addEventListener('click', close);
        dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
        if (dialog.hasAttribute('open')) {
          dialog.close();
          dialog.showModal();
        }
        updatePreview();
      }
    </script>
  </body>
</html>

<style>
  .admin-page { min-height: 100vh; padding: 0; background: #f3eee5; font-size: 0.94rem; }
  .admin-wrap { width: min(94vw, 92rem); margin-inline: auto; }
  .admin-main { padding-block: 3rem 6rem; }
  .admin-title { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .admin-title h1 { max-width: none; font-size: clamp(2.5rem, 5vw, 4.4rem); }
  .calendar-controls { display: grid; justify-items: end; gap: 0.65rem; }
  .view-switch { display: flex; padding: 0.2rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
  .view-switch a { padding: 0.45rem 0.85rem; border-radius: 999px; color: var(--pine-dark); font-size: 0.78rem; font-weight: 700; text-decoration: none; }
