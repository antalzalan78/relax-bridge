---
import BookingPage from '../../components/BookingPage.astro';
import { bookingEntryRedirect } from '../../lib/booking/entry-route';
import type { Locale } from '../../data/site';

export const prerender = false;

const locale = Astro.params.lang;
if (locale !== 'en' && locale !== 'hu') return new Response('Not found', { status: 404 });

const destination = bookingEntryRedirect(locale as Locale, Astro.url);
if (destination) return Astro.redirect(destination, 302);
---

<BookingPage locale={locale} />
