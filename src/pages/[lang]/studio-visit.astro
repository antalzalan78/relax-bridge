---
import StudioVisitBookingPage from '../../components/StudioVisitBookingPage.astro';
import type { Locale } from '../../data/site';

export function getStaticPaths() {
  return ['en', 'hu'].map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<StudioVisitBookingPage locale={locale} />

