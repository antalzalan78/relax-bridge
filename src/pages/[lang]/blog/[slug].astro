---
import BlogArticle from '../../../components/BlogArticle.astro';
import { getPublished } from '../../../lib/server/blog';
import type { Locale } from '../../../data/site';
export const prerender = false;
const lang = Astro.params.lang;
if (lang !== 'en' && lang !== 'hu') return new Response('Not found', { status: 404 });
const post = await getPublished(lang as Locale, Astro.params.slug || '');
if (!post) return new Response('Not found', { status: 404 });
---
<BlogArticle locale={lang as Locale} post={post} />
