---
/** A ket partot osszekoto, nyugodt hidvonal. Tisztan dekorativ. */
---

<div class="bridge-divider" aria-hidden="true">
  <svg viewBox="0 0 1200 92" preserveAspectRatio="none" focusable="false">
    <path class="bridge-divider__shadow" d="M0 73 C 245 73 340 25 600 25 S 955 73 1200 73" />
    <path class="bridge-divider__line" d="M0 65 C 245 65 340 17 600 17 S 955 65 1200 65" />
    <circle cx="0" cy="65" r="4" />
    <circle cx="1200" cy="65" r="4" />
  </svg>
</div>

<style>
  .bridge-divider {
    width: 100%;
    line-height: 0;
    margin-block: 0.5rem;
  }

  .bridge-divider svg {
    display: block;
    width: 100%;
    height: clamp(3.5rem, 8vw, 5.75rem);
    overflow: visible;
  }

  .bridge-divider path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .bridge-divider__shadow {
    stroke: var(--sand);
  }

  .bridge-divider__line {
    stroke: var(--clay);
  }

  .bridge-divider circle {
    fill: var(--pine);
  }
</style>
