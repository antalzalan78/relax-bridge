---
/** A ket partot osszekoto, nyugodt hidvonal. Tisztan dekorativ. */
interface Props {
  animate?: boolean;
}

const { animate = false } = Astro.props;
---

<div class="bridge-divider" data-wave-animate={animate ? '' : undefined} aria-hidden="true">
  <svg viewBox="0 0 1200 92" preserveAspectRatio="none" focusable="false">
    <path class="bridge-divider__shadow" d="M0 73 C 245 73 340 25 600 25 S 955 73 1200 73" />
    <path class="bridge-divider__line" pathLength="1" d="M0 65 C 245 65 340 17 600 17 S 955 65 1200 65" />
    <circle cx="0" cy="65" r="4" />
    <circle class="bridge-divider__finish" cx="1200" cy="65" r="4" />
  </svg>
</div>

<script>
  const dividers = document.querySelectorAll<HTMLElement>('[data-wave-animate]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Keep the line visible when JavaScript, IntersectionObserver or animation is unavailable.
  if (dividers.length && !reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('bridge-divider--revealed');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.4 });

    dividers.forEach((divider) => {
      divider.classList.add('bridge-divider--prepared');
      observer.observe(divider);
    });

    reducedMotion.addEventListener('change', (event) => {
      if (!event.matches) return;
      observer.disconnect();
      dividers.forEach((divider) => divider.classList.remove('bridge-divider--prepared'));
    });
  }
</script>

<style>
  .bridge-divider {
    width: 100%;
    line-height: 0;
    margin-block: 0.5rem;
  }

  .bridge-divider svg {
    display: block;
    width: 100%;
    height: clamp(3.5rem, 8vw, 5.75rem);
    overflow: visible;
  }

  .bridge-divider path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .bridge-divider__shadow {
    stroke: var(--sand);
  }

  .bridge-divider__line {
    stroke: var(--clay);
  }

  .bridge-divider circle {
    fill: var(--pine);
  }

  .bridge-divider--prepared .bridge-divider__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .bridge-divider--prepared .bridge-divider__finish {
    opacity: 0;
  }

  .bridge-divider--revealed .bridge-divider__line {
    animation: bridge-draw 1.15s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .bridge-divider--revealed .bridge-divider__finish {
    animation: bridge-finish 0.25s ease-out 1.05s both;
  }

  @keyframes bridge-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes bridge-finish {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bridge-divider--prepared .bridge-divider__line { stroke-dashoffset: 0; }
    .bridge-divider--prepared .bridge-divider__finish { opacity: 1; }
    .bridge-divider--revealed .bridge-divider__line,
    .bridge-divider--revealed .bridge-divider__finish { animation: none; }
  }
</style>
