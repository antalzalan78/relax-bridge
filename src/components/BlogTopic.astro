---
import Base from '../layouts/Base.astro';
import BlogCards from './BlogCards.astro';
import BlogVisual from './BlogVisual.astro';
import { blogPath, blogTopicPath, type Locale } from '../data/site';
import { blogText } from '../i18n/blog';
import { listPublished, listTopics, topicCoverUrl, topicDescription } from '../lib/server/blog';
import '../styles/blog.css';
interface Props { locale: Locale; topicId: string }
const { locale, topicId } = Astro.props;
const c = blogText(locale);
// The route checks the topic before rendering this component.
const topic = (await listTopics()).find((item) => item.id === topicId)!;
const posts = await listPublished(locale, topicId);
const alternates = Object.fromEntries((['nl', 'en', 'hu'] as const).filter((lang) => topic.names[lang]).map((lang) => [lang, blogTopicPath(lang, topicId)]));
---
<Base locale={locale} title={`${topic.names[locale]} — Relax Bridge`} description={topicDescription(topic, locale) || c.description} path={blogTopicPath(locale, topicId)} alternates={alternates} indexAllLocales noIndex={posts.length === 0} quietBackdrop>
  <div class="blog-page">
    <header class="blog-hero blog-hero--topic blog-wrap"><nav class="blog-breadcrumb" aria-label="Breadcrumb"><a href={blogPath(locale)}>← {c.backToAll}</a></nav><div class="blog-topic-hero__cover"><BlogVisual topicId={topic.id} image={topicCoverUrl(topic)} topicCover large /></div><span class="blog-eyebrow">{c.topicLabel}</span><h1>{topic.names[locale]}</h1>{topicDescription(topic, locale) && <p class="blog-lead">{topicDescription(topic, locale)}</p>}</header>
    <section class="blog-section blog-wrap" aria-label={c.latest}>{posts.length ? <BlogCards locale={locale} posts={posts} /> : <div class="blog-empty"><p>{c.topicEmpty}</p></div>}</section>
  </div>
</Base>
