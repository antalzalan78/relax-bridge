---
import {
  site,
  localeTags,
  defaultLocale,
  isSearchIndexableLocale,
  type Locale,
} from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Az aktualis oldal utvonala, pl. '/massage/relaxmassage' */
  path: string;
  /** Ugyanaz az oldal a tobbi nyelven: { nl: '/...', en: '/en/...' } */
  alternates: Partial<Record<Locale, string>>;
  /** Tetszoleges strukturalt adat (LocalBusiness, Service, ...) */
  jsonLd?: Record<string, unknown>[];
  image?: string;
  indexAllLocales?: boolean;
  noIndex?: boolean;
  contentType?: 'article' | 'website';
  publishedAt?: Date | null;
  author?: string;
}

const { locale, title, description, path, alternates, jsonLd = [], image, indexAllLocales = false, noIndex = false, contentType = 'website', publishedAt, author } =
  Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL(image ?? '/images/og-image.png', site.url).href;
const isSearchIndexable = !noIndex && (indexAllLocales || isSearchIndexableLocale(locale));
const dutchAlternate = alternates[defaultLocale];
---

<title>{title}</title>
<meta name="description" content={description} />
{!isSearchIndexable && <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'noindex, follow'} />}
<link rel="canonical" href={canonical} />

{/*
  Only the Dutch version is advertised to search engines. English and Hungarian
  remain available to visitors but are not published as search alternatives.
*/}
{
  !indexAllLocales && dutchAlternate && (
    <link
      rel="alternate"
      hreflang={localeTags[defaultLocale]}
      href={new URL(dutchAlternate, site.url).href}
    />
  )
}
{
  !indexAllLocales && dutchAlternate && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(dutchAlternate, site.url).href}
    />
  )
}
{indexAllLocales && Object.entries(alternates).map(([lang, href]) => (
  <link rel="alternate" hreflang={localeTags[lang as Locale]} href={new URL(href, site.url).href} />
))}
{indexAllLocales && alternates.nl && <link rel="alternate" hreflang="x-default" href={new URL(alternates.nl, site.url).href} />}

<meta property="og:type" content={contentType} />
{contentType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{contentType === 'article' && author && <meta property="article:author" content={author} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />

{
  jsonLd.map((data) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
    />
  ))
}
