---
import Base from '../layouts/Base.astro';
import BlogCards from './BlogCards.astro';
import { blogPath, blogTopicPath, locales, type Locale } from '../data/site';
import { blogText } from '../i18n/blog';
import { listPublished, listTopics } from '../lib/server/blog';
import '../styles/blog.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = blogText(locale);
const [posts, topics] = await Promise.all([listPublished(locale), listTopics()]);
const visibleTopics = topics.filter((topic) => topic.names[locale]);
const alternates = Object.fromEntries(locales.map((lang) => [lang, blogPath(lang)]));
---
<Base locale={locale} title={`${c.title} — Relax Bridge`} description={c.description} path={blogPath(locale)} alternates={alternates} indexAllLocales noIndex={posts.length === 0} quietBackdrop>
  <div class="blog-page">
    <header class="blog-hero blog-wrap">
      <span class="blog-eyebrow">{c.indexEyebrow}</span>
      <h1>{c.indexHeadline.split('\n').map((line) => <span>{line}</span>)}</h1>
      <p class="blog-lead">{c.description}</p>
    </header>
    {visibleTopics.length > 0 && <nav class="blog-topics blog-wrap" aria-label={c.topics}>
      <span class="blog-topics__label">{c.topics}</span>
      {visibleTopics.map((topic) => <a href={blogTopicPath(locale, topic.id)}>{topic.names[locale]} →</a>)}
    </nav>}
    <section class="blog-section blog-wrap" aria-label={c.latest}>
      {posts.length ? <BlogCards locale={locale} posts={posts} /> : <div class="blog-empty"><p>{c.empty}</p></div>}
    </section>
  </div>
</Base>
