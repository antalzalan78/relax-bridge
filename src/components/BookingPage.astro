---
import Base from '../layouts/Base.astro';
import { bookingPath, pathFor, privacyPath, type Locale } from '../data/site';
import { bookingText } from '../i18n/booking';
import { getBookingOptions, getHomeServiceBookingOptions } from '../lib/booking/catalog';
import {
  homeServiceMaximumGuests,
  homeServiceMaximumMinutes,
  homeServiceMinimumMinutes,
  homeServicePreparationMinutes,
  homeServiceTravelFeeEur,
} from '../lib/booking/home-service';
import { creatorAddons, creatorBases, creatorMaximumMinutes } from '../lib/booking/massage-creator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = bookingText(locale);
const allOptions = await getBookingOptions(locale);
const options = allOptions.filter((option) => option.category === 'studio');
const homeOptions = await getHomeServiceBookingOptions(locale);
const path = bookingPath(locale);
const privacyHref = privacyPath(locale);
const alternates = {
  nl: bookingPath('nl'),
  en: bookingPath('en'),
  hu: bookingPath('hu'),
};
const dateLocale = locale === 'nl' ? 'nl-NL' : locale === 'hu' ? 'hu-HU' : 'en-GB';
const creatorConfig = { bases: creatorBases, addons: creatorAddons, maximumMinutes: creatorMaximumMinutes };
const homeConfig = {
  maximumGuests: homeServiceMaximumGuests,
  minimumMinutes: homeServiceMinimumMinutes,
  maximumMinutes: homeServiceMaximumMinutes,
  preparationMinutes: homeServicePreparationMinutes,
  travelFeeEur: homeServiceTravelFeeEur,
};
---

<Base
  locale={locale}
  title={`${copy.title} — Relax Bridge`}
  description={copy.intro}
  path={path}
  alternates={alternates}
>
  <section class="booking-hero">
    <div class="wrap booking-hero__inner">
      <a class="back-link" href={pathFor(locale)}>
        <span aria-hidden="true">&larr;</span> Relax Bridge
      </a>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.intro}</p>
      <ol class="booking-steps" aria-label={copy.eyebrow}>
        {copy.steps.map((step, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap booking-shell">
    <form
      class="booking-form"
      id="booking-form"
      data-options={JSON.stringify(options)}
      data-locale={locale}
      data-date-locale={dateLocale}
      data-copy={JSON.stringify(copy)}
      data-creator-config={JSON.stringify(creatorConfig)}
      data-home-options={JSON.stringify(homeOptions)}
      data-home-config={JSON.stringify(homeConfig)}
    >
      <div class="booking-card booking-card--choice">
        <span class="booking-card__number">01</span>
        <div>
          <label id="service-label" for="service">{copy.service}</label>
          <select id="service" name="service" required>
            <option value="">{copy.chooseService}</option>
            {options.map((option) => (
              <option value={option.id} data-category={option.category}>
                {copy.studio} · {option.title} · {option.minutes} min · € {option.priceEur}
              </option>
            ))}
            <option value="home:custom" data-category="home">{copy.home}</option>
          </select>
        </div>

        <fieldset class="home-builder-fieldset" id="home-builder-fieldset" hidden disabled>
          <legend>{copy.homeBuilderTitle}</legend>
          <p>{copy.homeBuilderIntro}</p>
          <div class="home-builder-count">
            <label for="home-guest-count">{copy.homeGuestCount}</label>
            <select id="home-guest-count" name="homeGuestCount">
              {copy.homeGuestOptions.map((label, index) => (
                <option value={index + 1}>{label}</option>
              ))}
            </select>
          </div>
          <div class="home-guest-list" id="home-guest-list">
            {Array.from({ length: homeServiceMaximumGuests }, (_, index) => (
              <div class="home-guest-card" data-home-guest={index + 1} hidden={index > 0}>
                <strong>{copy.homeGuest.replace('{number}', String(index + 1))}</strong>
                <label for={`home-treatment-${index + 1}`}>{copy.homeTreatment}</label>
                <select
                  id={`home-treatment-${index + 1}`}
                  name={`homeTreatment${index + 1}`}
                  class="home-treatment-select"
                  data-home-treatment={index + 1}
                  disabled={index > 0}
                >
                  <option value="">{copy.homeChooseTreatment}</option>
                  {homeOptions.map((option) => (
                    <option value={option.id}>
                      {option.title} · {option.minutes} min · € {option.priceEur}
                    </option>
                  ))}
                </select>
              </div>
            ))}
          </div>
          <div class="home-builder-summary" id="home-builder-summary" aria-live="polite">
            {copy.homeChooseAll}
          </div>
        </fieldset>

        <div>
          <label for="booking-date">{copy.date}</label>
          <input id="booking-date" name="date" type="date" required />
        </div>

        <fieldset class="slot-fieldset">
          <legend>{copy.time}</legend>
          <p class="slot-status" id="slot-status">{copy.chooseFirst}</p>
          <div class="slot-grid" id="slot-grid"></div>
        </fieldset>

        <fieldset class="creator-fieldset" id="creator-fieldset" hidden disabled>
          <legend>{copy.preferencesTitle}</legend>
          <p>{copy.creatorIntro}</p>
          <div class="creator-grid">
            <div>
              <label for="creator-scent">{copy.creatorScent}</label>
              <select id="creator-scent" name="creatorScent">
                <option value="">{copy.creatorScentPlaceholder}</option>
                {copy.creatorScentOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="creator-music">{copy.creatorMusic}</label>
              <select id="creator-music" name="creatorMusic">
                <option value="">{copy.creatorMusicPlaceholder}</option>
                {copy.creatorMusicOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          </div>
          <label class="creator-check">
            <input name="creatorBioVegan" type="checkbox" />
            <span>{copy.creatorBioVegan}</span>
          </label>
        </fieldset>
      </div>

      <div class="booking-card booking-card--details" id="details-card" hidden>
        <span class="booking-card__number">02</span>
        <div class="appointment-summary" id="appointment-summary" aria-live="polite"></div>
        <input type="hidden" id="start" name="start" />

        <div class="field-grid">
          <div>
            <label for="customer-name">{copy.name}</label>
            <input id="customer-name" name="customerName" autocomplete="name" required maxlength="100" />
          </div>
          <div>
            <label for="customer-email">{copy.email}</label>
            <input id="customer-email" name="customerEmail" type="email" autocomplete="email" required maxlength="200" />
          </div>
          <div>
            <label for="customer-phone">{copy.phone}</label>
            <input id="customer-phone" name="customerPhone" type="tel" autocomplete="tel" required maxlength="40" />
          </div>
          <div id="address-field" hidden>
            <label for="home-address">{copy.address}</label>
            <input id="home-address" name="homeAddress" autocomplete="street-address" maxlength="300" />
          </div>
        </div>

        <label for="notes">{copy.notes}</label>
        <textarea id="notes" name="notes" rows="3" maxlength="1000"></textarea>

        <div hidden>
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent">
          <input name="consent" type="checkbox" required />
          <span>{copy.consent}</span>
        </label>
        <p class="privacy-note">
          {copy.privacy} <a href={privacyHref}>{copy.privacyLink}</a>.
        </p>

        <button class="btn btn--primary btn--block" id="submit-booking" type="submit">
          {copy.submit}<span aria-hidden="true">&rarr;</span>
        </button>
        <p class="form-error" id="form-error" role="alert" hidden></p>
      </div>
    </form>

    <div class="booking-confirmation" id="booking-confirmation" hidden aria-live="polite">
      <span class="confirmation-mark" aria-hidden="true">✓</span>
      <span class="eyebrow">Relax Bridge</span>
      <h2>{copy.confirmed}</h2>
      <p>{copy.confirmedBody}</p>
      <div class="confirmation-reference">
        <span>{copy.reference}</span>
        <strong id="confirmation-reference"></strong>
      </div>
      <button class="btn btn--ghost" id="another-booking" type="button">{copy.another}</button>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#booking-form');

  if (form) {
    const options = JSON.parse(form.dataset.options || '[]');
    const homeOptions = JSON.parse(form.dataset.homeOptions || '[]');
    const homeConfig = JSON.parse(form.dataset.homeConfig || '{}');
    const locale = form.dataset.locale || 'nl';
    const dateLocale = form.dataset.dateLocale || 'nl-NL';
    const copy = JSON.parse(form.dataset.copy || '{}');
    const creatorConfig = JSON.parse(form.dataset.creatorConfig || '{}');
    const service = form.querySelector<HTMLSelectElement>('#service')!;
    const serviceLabel = form.querySelector<HTMLElement>('#service-label')!;
    const searchParams = new URLSearchParams(window.location.search);
    const requestedCategory = searchParams.get('category');
    const requestedService = searchParams.get('service');
    let requestedCreator: any = null;

    if (searchParams.get('creator') === '1') {
      const base = searchParams.get('base');
      const back = Number(searchParams.get('back') || 0);
      const face = Number(searchParams.get('face') || 0);
      const foot = Number(searchParams.get('foot') || 0);
      const baseConfig = creatorConfig.bases?.[base || ''];
      const validDurations = [0, 15, 30];
      const minutes = baseConfig ? baseConfig.minutes + back + face + foot : 0;
      const valid = baseConfig
        && [0, 30].includes(back)
        && validDurations.includes(face)
        && validDurations.includes(foot)
        && !(base === 'back' && back)
        && minutes <= creatorConfig.maximumMinutes;

      if (valid) {
        const addonPrice = (kind: string, duration: number) => duration ? Number(creatorConfig.addons[kind][duration]) : 0;
        requestedCreator = {
          id: `studio:creator:${base}:${back}:${face}:${foot}`,
          key: baseConfig.serviceKey,
          category: 'studio',
          title: copy.creatorTitle,
          minutes,
          priceEur: baseConfig.priceEur + addonPrice('back', back) + addonPrice('face', face) + addonPrice('foot', foot),
          creatorBase: base,
          creatorBack: back,
          creatorFace: face,
          creatorFoot: foot,
        };
        options.push(requestedCreator);
        const creatorOption = document.createElement('option');
        creatorOption.value = requestedCreator.id;
        creatorOption.dataset.category = 'studio';
        creatorOption.textContent = `${copy.creatorTitle} · ${minutes} min · € ${requestedCreator.priceEur}`;
        service.replaceChildren(creatorOption);
        service.value = requestedCreator.id;
        service.disabled = true;
        serviceLabel.textContent = copy.creatorTitle;
      }
    }

    if (!requestedCreator && (requestedCategory === 'studio' || requestedCategory === 'home')) {
      service.querySelectorAll<HTMLOptionElement>('option[data-category]').forEach((option) => {
        if (option.dataset.category !== requestedCategory) option.remove();
      });
      if (requestedCategory === 'home') {
        service.value = 'home:custom';
        service.disabled = true;
        serviceLabel.textContent = copy.homeBuilderTitle;
      }
    }
    const preselectedOption = requestedCreator || (requestedService
      ? options.find(
          (option: any) => `${option.category}:${option.key}` === requestedService,
        )
      : undefined);
    const date = form.querySelector<HTMLInputElement>('#booking-date')!;
    const slotStatus = form.querySelector<HTMLElement>('#slot-status')!;
    const slotGrid = form.querySelector<HTMLElement>('#slot-grid')!;
    const start = form.querySelector<HTMLInputElement>('#start')!;
    const details = form.querySelector<HTMLElement>('#details-card')!;
    const summary = form.querySelector<HTMLElement>('#appointment-summary')!;
    const addressField = form.querySelector<HTMLElement>('#address-field')!;
    const address = form.querySelector<HTMLInputElement>('#home-address')!;
    const creatorFieldset = form.querySelector<HTMLFieldSetElement>('#creator-fieldset')!;
    const homeFieldset = form.querySelector<HTMLFieldSetElement>('#home-builder-fieldset')!;
    const homeGuestCount = form.querySelector<HTMLSelectElement>('#home-guest-count')!;
    const homeGuestCards = Array.from(form.querySelectorAll<HTMLElement>('[data-home-guest]'));
    const homeTreatmentSelects = Array.from(form.querySelectorAll<HTMLSelectElement>('.home-treatment-select'));
    const homeSummary = form.querySelector<HTMLElement>('#home-builder-summary')!;
    const scentSelect = form.querySelector<HTMLSelectElement>('#creator-scent')!;
    const musicSelect = form.querySelector<HTMLSelectElement>('#creator-music')!;
    const submit = form.querySelector<HTMLButtonElement>('#submit-booking')!;
    const formError = form.querySelector<HTMLElement>('#form-error')!;
    const confirmation = document.querySelector<HTMLElement>('#booking-confirmation')!;
    const reference = document.querySelector<HTMLElement>('#confirmation-reference')!;
    const another = document.querySelector<HTMLButtonElement>('#another-booking')!;

    const applyRequestedPreference = (select: HTMLSelectElement, value: string | null) => {
      if (value && Array.from(select.options).some((option) => option.value === value)) {
        select.value = value;
      }
    };
    applyRequestedPreference(scentSelect, searchParams.get('scent'));
    applyRequestedPreference(musicSelect, searchParams.get('music'));

    const dateInAmsterdam = (value = new Date()) =>
      new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Europe/Amsterdam',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(value);
    const today = dateInAmsterdam();
    const maximum = new Date(`${today}T12:00:00Z`);
    maximum.setUTCDate(maximum.getUTCDate() + 60);
    date.min = today;
    date.max = dateInAmsterdam(maximum);
    date.value = today;

    const activeHomeSelects = () =>
      homeTreatmentSelects.slice(0, Number(homeGuestCount.value || 1));

    const buildHomeOption = () => {
      if (service.value !== 'home:custom') return undefined;
      const selects = activeHomeSelects();
      const treatments = selects
        .map((select) => homeOptions.find((option: any) => option.id === select.value))
        .filter(Boolean);
      if (treatments.length !== selects.length) return undefined;

      const minutes = treatments.reduce((total: number, option: any) => total + option.minutes, 0);
      if (minutes < homeConfig.minimumMinutes || minutes > homeConfig.maximumMinutes) return undefined;
      const preparationMinutes = (treatments.length - 1) * homeConfig.preparationMinutes;
      const treatmentPriceEur = treatments.reduce(
        (total: number, option: any) => total + option.priceEur,
        0,
      );

      return {
        id: 'home:custom',
        key: treatments[0].key,
        category: 'home',
        title: copy.home,
        minutes,
        preparationMinutes,
        reservedMinutes: minutes + preparationMinutes,
        treatmentPriceEur,
        priceEur: treatmentPriceEur + homeConfig.travelFeeEur,
        homeTreatments: treatments.map((option: any) => ({ key: option.key, minutes: option.minutes })),
      };
    };

    const selectedOption = () =>
      service.value === 'home:custom'
        ? buildHomeOption()
        : options.find((option: any) => option.id === service.value);

    const updateHomeBuilder = () => {
      const guestCount = Number(homeGuestCount.value || 1);
      homeGuestCards.forEach((card, index) => {
        const active = index < guestCount;
        card.hidden = !active;
        homeTreatmentSelects[index].disabled = !active;
        if (!active) homeTreatmentSelects[index].value = '';
      });

      const active = activeHomeSelects();
      active.forEach((select) => {
        const otherMinutes = active.reduce((total, other) => {
          if (other === select) return total;
          const option = homeOptions.find((item: any) => item.id === other.value);
          return total + (option?.minutes || 0);
        }, 0);
        const unselectedOtherGuests = active.filter(
          (other) => other !== select && !other.value,
        ).length;
        Array.from(select.options).forEach((option) => {
          if (!option.value) return;
          const treatment = homeOptions.find((item: any) => item.id === option.value);
          option.disabled =
            !treatment ||
            otherMinutes + treatment.minutes +
              unselectedOtherGuests * homeConfig.minimumMinutes >
              homeConfig.maximumMinutes;
        });
      });

      const option = buildHomeOption();
      if (!option) {
        homeSummary.textContent = copy.homeChooseAll;
        return;
      }

      const preparation = option.preparationMinutes
        ? `<span><small>${copy.homePreparationTime}</small><strong>${option.preparationMinutes} min</strong></span>`
        : '';
      homeSummary.innerHTML = `
        <span><small>${copy.homeMassageTime}</small><strong>${option.minutes} min</strong></span>
        ${preparation}
        <span><small>${copy.homeReservedTime}</small><strong>${option.reservedMinutes} min</strong></span>
        <span><small>${copy.homeTreatmentSubtotal}</small><strong>€ ${option.treatmentPriceEur}</strong></span>
        <span><small>${copy.homeTravelFee}</small><strong>€ ${homeConfig.travelFeeEur}</strong></span>
        <span><small>${copy.homeTotalPrice}</small><strong>€ ${option.priceEur}</strong></span>
      `;
    };

    const setChoiceVisibility = (option = selectedOption()) => {
      const home = service.value === 'home:custom';
      homeFieldset.hidden = !home;
      homeFieldset.disabled = !home;
      if (home) updateHomeBuilder();
      const studio = option?.category === 'studio' || (!option && requestedCategory === 'studio');
      creatorFieldset.hidden = !studio;
      creatorFieldset.disabled = !studio;
    };
    setChoiceVisibility();
    const readableDate = () =>
      new Intl.DateTimeFormat(dateLocale, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Europe/Amsterdam',
      }).format(new Date(`${date.value}T12:00:00Z`));

    async function loadSlots() {
      start.value = '';
      details.hidden = true;
      slotGrid.replaceChildren();
      const option = selectedOption();
      setChoiceVisibility(option);
      if (!option || !date.value) {
        slotStatus.textContent = service.value === 'home:custom' ? copy.homeChooseAll : copy.chooseFirst;
        return;
      }

      slotStatus.textContent = copy.loading;
      try {
        const params = new URLSearchParams({
          date: date.value,
          category: option.category,
          minutes: String(option.reservedMinutes || option.minutes),
        });
        const response = await fetch(`/api/availability?${params}`);
        if (!response.ok) throw new Error('availability');
        const payload = await response.json();
        slotStatus.textContent = payload.slots.length ? '' : copy.noSlots;

        for (const slot of payload.slots) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'slot-button';
          button.textContent = slot.label;
          button.addEventListener('click', () => {
            slotGrid.querySelectorAll('button').forEach((item) => item.removeAttribute('aria-pressed'));
            button.setAttribute('aria-pressed', 'true');
            start.value = slot.start;
            const optionName = option.category === 'home' ? copy.home : option.title;
            const homeDetails = option.category === 'home'
              ? `${copy.homeMassageTime}: ${option.minutes} min · ${copy.homeReservedTime}: ${option.reservedMinutes} min · ${copy.homeTotalPrice}: € ${option.priceEur}`
              : `${optionName} · ${option.minutes} min · € ${option.priceEur}`;
            summary.innerHTML = `<span>${copy.selected}</span><strong>${readableDate()} · ${slot.label}</strong><small>${homeDetails}</small>`;
            const home = option.category === 'home';
            addressField.hidden = !home;
            address.required = home;
            details.hidden = false;
            details.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          slotGrid.append(button);
        }
      } catch {
        slotStatus.textContent = copy.error;
      }
    }

    service.addEventListener('change', loadSlots);
    date.addEventListener('change', loadSlots);
    homeGuestCount.addEventListener('change', () => {
      const active = activeHomeSelects();
      const selectedMinutes = () => active.reduce((total, select) => {
        const option = homeOptions.find((item: any) => item.id === select.value);
        return total + (option?.minutes || 0);
      }, 0);
      const minimumPossibleMinutes = () =>
        selectedMinutes() + active.filter((select) => !select.value).length * homeConfig.minimumMinutes;
      while (minimumPossibleMinutes() > homeConfig.maximumMinutes) {
        const longest = active
          .map((select) => ({
            select,
            option: homeOptions.find((item: any) => item.id === select.value),
          }))
          .filter((item) => item.option)
          .sort((a, b) => b.option.minutes - a.option.minutes)[0];
        if (!longest) break;
        longest.select.value = '';
      }
      updateHomeBuilder();
      void loadSlots();
    });
    homeTreatmentSelects.forEach((select) => {
      select.addEventListener('change', () => {
        updateHomeBuilder();
        void loadSlots();
      });
    });

    if (preselectedOption) {
      service.value = preselectedOption.id;
      void loadSlots();
    } else if (service.value === 'home:custom') {
      void loadSlots();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const option = selectedOption();
      if (!option || !start.value || !form.reportValidity()) return;
      submit.disabled = true;
      submit.firstChild!.textContent = copy.submitting;
      formError.hidden = true;

      const data = new FormData(form);
      const payload = {
        locale,
        key: option.key,
        category: option.category,
        minutes: option.minutes,
        start: start.value,
        customerName: data.get('customerName'),
        customerEmail: data.get('customerEmail'),
        customerPhone: data.get('customerPhone'),
        homeAddress: data.get('homeAddress') || undefined,
        creatorScent: data.get('creatorScent') || undefined,
        creatorMusic: data.get('creatorMusic') || undefined,
        creatorBioVegan: data.get('creatorBioVegan') === 'on',
        creatorBase: option.creatorBase || undefined,
        creatorBack: option.creatorBack ?? undefined,
        creatorFace: option.creatorFace ?? undefined,
        creatorFoot: option.creatorFoot ?? undefined,
        homeTreatments: option.homeTreatments || undefined,
        notes: data.get('notes') || undefined,
        website: data.get('website') || undefined,
        consent: data.get('consent') === 'on',
      };

      try {
        const response = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok) {
          if (response.status === 409) {
            formError.textContent = copy.unavailable;
            formError.hidden = false;
            await loadSlots();
            return;
          }
          throw new Error(result.error);
        }

        reference.textContent = result.booking.reference;
        form.hidden = true;
        confirmation.hidden = false;
        confirmation.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        formError.textContent = copy.error;
        formError.hidden = false;
      } finally {
        submit.disabled = false;
        submit.firstChild!.textContent = copy.submit;
      }
    });

    another.addEventListener('click', () => {
      form.reset();
      if (requestedCategory === 'home') service.value = 'home:custom';
      date.value = today;
      start.value = '';
      details.hidden = true;
      slotGrid.replaceChildren();
      slotStatus.textContent = copy.chooseFirst;
      setChoiceVisibility();
      confirmation.hidden = true;
      form.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>

<style>
  .booking-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--pine-dark);
    color: #fff;
  }

  .booking-hero::after {
    position: absolute;
    inset: 20% -12% -135%;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50% 50% 0 0;
    content: '';
  }

  .booking-hero__inner { position: relative; z-index: 1; }
  .booking-hero .back-link,
  .booking-hero .eyebrow,
  .booking-hero .lead { color: #fff; }
  .booking-hero .back-link { margin-bottom: 2.5rem; opacity: 0.72; }
  .booking-hero .lead { max-width: 44rem; opacity: 0.76; }

  .booking-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
