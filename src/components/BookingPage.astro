---
import Base from '../layouts/Base.astro';
import { bookingPath, pathFor, privacyPath, type Locale } from '../data/site';
import { bookingText } from '../i18n/booking';
import { getBookingOptions } from '../lib/booking/catalog';
import { creatorAddons, creatorBases, creatorMaximumMinutes } from '../lib/booking/massage-creator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = bookingText(locale);
const allOptions = await getBookingOptions(locale);
const options = allOptions.filter((option) => option.category === 'studio');
const path = bookingPath(locale);
const privacyHref = privacyPath(locale);
const alternates = {
  nl: bookingPath('nl'),
  en: bookingPath('en'),
  hu: bookingPath('hu'),
};
const dateLocale = locale === 'nl' ? 'nl-NL' : locale === 'hu' ? 'hu-HU' : 'en-GB';
const creatorConfig = { bases: creatorBases, addons: creatorAddons, maximumMinutes: creatorMaximumMinutes };
---

<Base
  locale={locale}
  title={`${copy.title} — Relax Bridge`}
  description={copy.intro}
  path={path}
  alternates={alternates}
  showMobileBooking={false}
  quietBackdrop
>
  <div id="booking-flow">
  <section class="booking-hero">
    <div class="wrap booking-hero__inner">
      <a class="back-link" href={pathFor(locale)}>
        <span aria-hidden="true">&larr;</span> Relax Bridge
      </a>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.intro}</p>
      <ol class="booking-steps" aria-label={copy.eyebrow}>
        {copy.steps.map((step, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap booking-shell">
    <form
      class="booking-form"
      id="booking-form"
      data-options={JSON.stringify(options)}
      data-locale={locale}
      data-date-locale={dateLocale}
      data-copy={JSON.stringify(copy)}
      data-creator-config={JSON.stringify(creatorConfig)}
    >
      <div class="booking-card booking-card--choice">
        <span class="booking-card__number">01</span>
        <div id="service-field">
          <label id="service-label" for="service">{copy.service}</label>
          <select id="service" name="service" required>
            <option value="">{copy.chooseService}</option>
            {options.map((option) => (
              <option value={option.id} data-category={option.category}>
                {option.title} · {option.minutes} min · € {option.priceEur}
              </option>
            ))}
          </select>
          <p class="field-instruction">{copy.serviceInstruction}</p>
        </div>

        <fieldset class="booking-date-field">
          <legend>{copy.date}</legend>
          <input id="booking-date" name="date" type="hidden" />
          <div class="booking-calendar">
            <div class="booking-calendar__header">
              <button id="calendar-previous" type="button" aria-label={copy.calendarPrevious}>&larr;</button>
              <strong id="calendar-month"></strong>
              <button id="calendar-next" type="button" aria-label={copy.calendarNext}>&rarr;</button>
            </div>
            <div class="booking-calendar__weekdays" id="calendar-weekdays" aria-hidden="true"></div>
            <div class="booking-calendar__grid" id="calendar-grid" role="grid"></div>
            <p class="booking-calendar__status" id="calendar-status" aria-live="polite">
              {copy.calendarChooseTreatment}
            </p>
            <div class="booking-calendar__legend">
              <i aria-hidden="true"></i>{copy.calendarAvailable}
            </div>
          </div>
        </fieldset>

        <fieldset class="slot-fieldset">
          <legend>{copy.time}</legend>
          <p class="slot-status" id="slot-status">{copy.chooseFirst}</p>
          <div class="slot-grid" id="slot-grid"></div>
        </fieldset>

        <fieldset class="creator-fieldset" id="creator-fieldset" hidden disabled>
          <legend>{copy.preferencesTitle}</legend>
          <p>{copy.creatorIntro}</p>
          <div class="creator-grid">
            <div>
              <label for="creator-scent">{copy.creatorScent}</label>
              <select id="creator-scent" name="creatorScent">
                <option value="">{copy.creatorScentPlaceholder}</option>
                {copy.creatorScentOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="creator-music">{copy.creatorMusic}</label>
              <select id="creator-music" name="creatorMusic">
                <option value="">{copy.creatorMusicPlaceholder}</option>
                {copy.creatorMusicOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="creator-fieldset__actions">
            <button class="btn btn--primary" id="preferences-continue" type="button" hidden>
              {copy.preferencesContinue}<span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </fieldset>
      </div>

      <div class="booking-card booking-card--details" id="details-card" hidden>
        <span class="booking-card__number">02</span>
        <div class="appointment-summary" id="appointment-summary" aria-live="polite"></div>
        <input type="hidden" id="start" name="start" />

        <div class="field-grid">
          <div>
            <label for="customer-name">{copy.name}</label>
            <input id="customer-name" name="customerName" autocomplete="name" required maxlength="100" />
          </div>
          <div>
            <label for="customer-email">{copy.email}</label>
            <input id="customer-email" name="customerEmail" type="email" autocomplete="email" required maxlength="200" />
          </div>
          <div>
            <label for="customer-phone">{copy.phone}</label>
            <input id="customer-phone" name="customerPhone" type="tel" autocomplete="tel" required maxlength="40" />
          </div>
        </div>

        <label for="notes">{copy.notes}</label>
        <textarea id="notes" name="notes" rows="3" maxlength="1000"></textarea>

        <div hidden>
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent">
          <input name="consent" type="checkbox" required />
          <span>{copy.consent}</span>
        </label>
        <p class="privacy-note">
          {copy.privacy} <a href={privacyHref}>{copy.privacyLink}</a>.
        </p>

        <button class="btn btn--primary btn--block" id="submit-booking" type="submit">
          {copy.submit}<span aria-hidden="true">&rarr;</span>
        </button>
        <p class="form-error" id="form-error" role="alert" hidden></p>
      </div>
    </form>

    <div class="booking-confirmation" id="booking-confirmation" hidden aria-live="polite">
      <span class="confirmation-mark" aria-hidden="true">✓</span>
      <span class="eyebrow">Relax Bridge</span>
      <h2>{copy.confirmed}</h2>
      <p>{copy.confirmedBody}</p>
      <div class="confirmation-reference">
        <span>{copy.reference}</span>
        <strong id="confirmation-reference"></strong>
      </div>
      <button class="btn btn--ghost" id="another-booking" type="button">{copy.another}</button>
    </div>
  </section>
  </div>
</Base>

<script>
  import { getAnalyticsSessionId } from '../scripts/website-analytics';

  const form = document.querySelector<HTMLFormElement>('#booking-form');

  if (form) {
    const options = JSON.parse(form.dataset.options || '[]');
    const locale = form.dataset.locale || 'nl';
    const dateLocale = form.dataset.dateLocale || 'nl-NL';
    const copy = JSON.parse(form.dataset.copy || '{}');
    const creatorConfig = JSON.parse(form.dataset.creatorConfig || '{}');
    const service = form.querySelector<HTMLSelectElement>('#service')!;
    const serviceLabel = form.querySelector<HTMLElement>('#service-label')!;
    const searchParams = new URLSearchParams(window.location.search);
    const requestedCategory = searchParams.get('category');
    const requestedService = searchParams.get('service');
    let requestedCreator: any = null;

    if (searchParams.get('creator') === '1') {
      const base = searchParams.get('base');
      const back = Number(searchParams.get('back') || 0);
      const face = Number(searchParams.get('face') || 0);
      const foot = Number(searchParams.get('foot') || 0);
      const baseConfig = creatorConfig.bases?.[base || ''];
      const validDurations = [0, 15, 30];
      const minutes = baseConfig ? baseConfig.minutes + back + face + foot : 0;
      const valid = baseConfig
        && [0, 30].includes(back)
        && validDurations.includes(face)
        && validDurations.includes(foot)
        && !(baseConfig.serviceKey === 'neck-shoulder-back' && back)
        && minutes <= creatorConfig.maximumMinutes;

      if (valid) {
        const addonPrice = (kind: string, duration: number) => duration ? Number(creatorConfig.addons[kind][duration]) : 0;
        requestedCreator = {
          id: `studio:creator:${base}:${back}:${face}:${foot}`,
          key: baseConfig.serviceKey,
          category: 'studio',
          title: copy.creatorTitle,
          minutes,
          priceEur: baseConfig.priceEur + addonPrice('back', back) + addonPrice('face', face) + addonPrice('foot', foot),
          creatorBase: base,
          creatorBack: back,
          creatorFace: face,
          creatorFoot: foot,
        };
        options.push(requestedCreator);
        const creatorOption = document.createElement('option');
        creatorOption.value = requestedCreator.id;
        creatorOption.dataset.category = 'studio';
        creatorOption.textContent = `${copy.creatorTitle} · ${minutes} min · € ${requestedCreator.priceEur}`;
        service.replaceChildren(creatorOption);
        service.value = requestedCreator.id;
        service.disabled = true;
        serviceLabel.textContent = copy.creatorTitle;
      }
    }

    if (!requestedCreator && requestedCategory === 'studio') {
      service.querySelectorAll<HTMLOptionElement>('option[data-category]').forEach((option) => {
        if (option.dataset.category !== 'studio') option.remove();
      });
    }
    const preselectedOption = requestedCreator || (requestedService
      ? options.find(
          (option: any) =>
            option.id === requestedService ||
            `${option.category}:${option.key}` === requestedService,
        )
      : undefined);
    const date = form.querySelector<HTMLInputElement>('#booking-date')!;
    const calendarMonthLabel = form.querySelector<HTMLElement>('#calendar-month')!;
    const calendarWeekdays = form.querySelector<HTMLElement>('#calendar-weekdays')!;
    const calendarGrid = form.querySelector<HTMLElement>('#calendar-grid')!;
    const calendarStatus = form.querySelector<HTMLElement>('#calendar-status')!;
    const calendarPrevious = form.querySelector<HTMLButtonElement>('#calendar-previous')!;
    const calendarNext = form.querySelector<HTMLButtonElement>('#calendar-next')!;
    const slotStatus = form.querySelector<HTMLElement>('#slot-status')!;
    const slotGrid = form.querySelector<HTMLElement>('#slot-grid')!;
    const start = form.querySelector<HTMLInputElement>('#start')!;
    const details = form.querySelector<HTMLElement>('#details-card')!;
    const summary = form.querySelector<HTMLElement>('#appointment-summary')!;
    const creatorFieldset = form.querySelector<HTMLFieldSetElement>('#creator-fieldset')!;
    const scentSelect = form.querySelector<HTMLSelectElement>('#creator-scent')!;
    const musicSelect = form.querySelector<HTMLSelectElement>('#creator-music')!;
    const preferencesContinue = form.querySelector<HTMLButtonElement>('#preferences-continue')!;
    const submit = form.querySelector<HTMLButtonElement>('#submit-booking')!;
    const formError = form.querySelector<HTMLElement>('#form-error')!;
    const confirmation = document.querySelector<HTMLElement>('#booking-confirmation')!;
    const reference = document.querySelector<HTMLElement>('#confirmation-reference')!;
    const another = document.querySelector<HTMLButtonElement>('#another-booking')!;

    const applyRequestedPreference = (select: HTMLSelectElement, value: string | null) => {
      if (value && Array.from(select.options).some((option) => option.value === value)) {
        select.value = value;
      }
    };
    applyRequestedPreference(scentSelect, searchParams.get('scent'));
    applyRequestedPreference(musicSelect, searchParams.get('music'));

    const dateInAmsterdam = (value = new Date()) =>
      new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Europe/Amsterdam',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(value);
    const today = dateInAmsterdam();
    const utcDate = (value: string) => new Date(`${value}T12:00:00Z`);
    const isoDate = (value: Date) => value.toISOString().slice(0, 10);
    const addUtcDays = (value: string, days: number) => {
      const result = utcDate(value);
      result.setUTCDate(result.getUTCDate() + days);
      return isoDate(result);
    };
    const defaultMaximum = addUtcDays(today, 60);
    let calendarMaximum = defaultMaximum;
    let calendarMonth = new Date(Date.UTC(
      utcDate(today).getUTCFullYear(),
      utcDate(today).getUTCMonth(),
      1,
      12,
    ));
    let availableDates = new Set<string>();
    let calendarRequest = 0;
    let calendarController: AbortController | null = null;
    let slotRequest = 0;
    date.value = '';

    const monthFormatter = new Intl.DateTimeFormat(dateLocale, {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
    const dayFormatter = new Intl.DateTimeFormat(dateLocale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
    const weekdayFormatter = new Intl.DateTimeFormat(dateLocale, {
      weekday: 'short',
      timeZone: 'UTC',
    });
    for (let index = 0; index < 7; index += 1) {
      const weekday = document.createElement('span');
      weekday.textContent = weekdayFormatter.format(new Date(Date.UTC(2026, 0, 5 + index, 12)));
      calendarWeekdays.append(weekday);
    }

    const selectedOption = () =>
      options.find((option: any) => option.id === service.value);

    const calendarOption = () => {
      const selected = selectedOption();
      if (selected) return selected;

      if (requestedCategory === 'studio') {
        return options
          .filter((option: any) => option.category === 'studio')
          .sort((left: any, right: any) => left.minutes - right.minutes)[0];
      }

      return undefined;
    };

    const calendarMonthBounds = () => {
      const year = calendarMonth.getUTCFullYear();
      const month = calendarMonth.getUTCMonth();
      return {
        first: new Date(Date.UTC(year, month, 1, 12)),
        last: new Date(Date.UTC(year, month + 1, 0, 12)),
      };
    };

    const renderCalendar = () => {
      const { first, last } = calendarMonthBounds();
      const firstWeekday = (first.getUTCDay() + 6) % 7;
      const minimumMonth = new Date(Date.UTC(
        utcDate(today).getUTCFullYear(),
        utcDate(today).getUTCMonth(),
        1,
        12,
      ));
      const maximumDate = utcDate(calendarMaximum);
      const maximumMonth = new Date(Date.UTC(
        maximumDate.getUTCFullYear(),
        maximumDate.getUTCMonth(),
        1,
        12,
      ));

      calendarMonthLabel.textContent = monthFormatter.format(first);
      calendarPrevious.disabled = calendarMonth.getTime() <= minimumMonth.getTime();
      calendarNext.disabled = calendarMonth.getTime() >= maximumMonth.getTime();
      calendarGrid.replaceChildren();

      for (let index = 0; index < firstWeekday; index += 1) {
        const blank = document.createElement('span');
        blank.className = 'booking-calendar__blank';
        blank.setAttribute('aria-hidden', 'true');
        calendarGrid.append(blank);
      }

      for (let day = 1; day <= last.getUTCDate(); day += 1) {
        const calendarDate = new Date(Date.UTC(
          first.getUTCFullYear(),
          first.getUTCMonth(),
          day,
          12,
        ));
        const value = isoDate(calendarDate);
        const available = availableDates.has(value);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'booking-calendar__day';
        button.textContent = String(day);
        button.setAttribute('role', 'gridcell');
        button.setAttribute('aria-label', dayFormatter.format(calendarDate));
        button.setAttribute('aria-pressed', String(date.value === value));
        button.disabled = !available || value < today || value > calendarMaximum;
        if (available) button.dataset.available = 'true';
        if (value === today) button.dataset.today = 'true';
        if (date.value === value) button.dataset.selected = 'true';
        button.addEventListener('click', () => {
          date.value = value;
          renderCalendar();
          void loadSlots();
        });
        calendarGrid.append(button);
      }
    };

    const loadAvailabilityCalendar = async (resetDate = false) => {
      const requestId = ++calendarRequest;
      calendarController?.abort();
      const controller = new AbortController();
      calendarController = controller;
      if (resetDate) {
        slotRequest += 1;
        date.value = '';
        start.value = '';
        details.hidden = true;
        preferencesContinue.hidden = true;
        slotGrid.replaceChildren();
        slotStatus.textContent = copy.chooseFirst;
      }
      availableDates = new Set();
      renderCalendar();

      const option = calendarOption();
      if (!option) {
        calendarStatus.textContent = copy.calendarChooseTreatment;
        return;
      }

      calendarStatus.textContent = copy.calendarLoading;
      const { first, last } = calendarMonthBounds();
      const params = new URLSearchParams({
        from: isoDate(first),
        to: isoDate(last),
        category: option.category,
        minutes: String(option.reservedMinutes || option.minutes),
      });

      let quickSucceeded = false;
      let freshComplete = false;
      let freshFailed = false;
      const applyCalendar = (payload: { lastDay?: string; dates?: string[] }, provisional: boolean) => {
        if (requestId !== calendarRequest) return;
        calendarMaximum = payload.lastDay || defaultMaximum;
        availableDates = new Set(payload.dates || []);
        if (date.value && !availableDates.has(date.value)) {
          slotRequest += 1;
          date.value = '';
          start.value = '';
          details.hidden = true;
          preferencesContinue.hidden = true;
          slotGrid.replaceChildren();
          slotStatus.textContent = copy.chooseFirst;
        }
        calendarStatus.textContent = provisional
          ? copy.calendarChecking
          : availableDates.size ? '' : copy.calendarNoAvailability;
        renderCalendar();
      };
      const requestCalendar = async (quick: boolean) => {
        const query = new URLSearchParams(params);
        if (quick) query.set('quick', '1');
        const response = await fetch(`/api/availability?${query}`, { signal: controller.signal });
        if (!response.ok) throw new Error('availability');
        return response.json();
      };
      const quickRequest = requestCalendar(true).then((payload) => {
        quickSucceeded = true;
        if (!freshComplete) {
          applyCalendar(payload, true);
          if (freshFailed && requestId === calendarRequest) {
            calendarStatus.textContent = copy.calendarRefreshFailed;
          }
        }
      }).catch(() => {});
      const freshRequest = requestCalendar(false).then((payload) => {
        freshComplete = true;
        applyCalendar(payload, false);
      }).catch(() => {
        if (requestId !== calendarRequest) return;
        freshFailed = true;
        calendarStatus.textContent = quickSucceeded ? copy.calendarRefreshFailed : copy.error;
        renderCalendar();
      });
      await Promise.all([quickRequest, freshRequest]);
      if (requestId === calendarRequest) calendarController = null;
    };

    const setChoiceVisibility = (option = selectedOption()) => {
      const studio = option?.category === 'studio' || (!option && requestedCategory === 'studio');
      creatorFieldset.hidden = !studio;
      creatorFieldset.disabled = !studio;
    };
    setChoiceVisibility();
    const readableDate = () =>
      new Intl.DateTimeFormat(dateLocale, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Europe/Amsterdam',
      }).format(new Date(`${date.value}T12:00:00Z`));

    async function loadSlots() {
      const requestId = ++slotRequest;
      start.value = '';
      details.hidden = true;
      preferencesContinue.hidden = true;
      slotGrid.replaceChildren();
      const option = selectedOption();
      setChoiceVisibility(option);
      if (!option || !date.value) {
        slotStatus.textContent = copy.chooseFirst;
        return;
      }

      slotStatus.textContent = copy.loading;
      try {
        const requestedDate = date.value;
        const requestedService = service.value;
        const params = new URLSearchParams({
          date: date.value,
          category: option.category,
          minutes: String(option.reservedMinutes || option.minutes),
        });
        const response = await fetch(`/api/availability?${params}`);
        if (!response.ok) throw new Error('availability');
        const payload = await response.json();
        if (requestId !== slotRequest || date.value !== requestedDate || service.value !== requestedService) return;
        slotStatus.textContent = payload.slots.length ? '' : copy.noSlots;

        const shownSlots = [
          ...payload.slots.map((slot: any) => ({ ...slot, unavailable: false })),
          ...(payload.unavailableSlots || []).map((slot: any) => ({ ...slot, unavailable: true })),
        ].sort((first: any, second: any) => first.start.localeCompare(second.start));
        for (const slot of shownSlots) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'slot-button';
          button.textContent = slot.label;
          if (slot.unavailable) {
            button.disabled = true;
            button.title = copy.unavailableSlot;
            button.setAttribute('aria-label', `${slot.label} · ${copy.unavailableSlot}`);
            slotGrid.append(button);
            continue;
          }
          button.addEventListener('click', () => {
            slotGrid.querySelectorAll('button').forEach((item) => item.removeAttribute('aria-pressed'));
            button.setAttribute('aria-pressed', 'true');
            start.value = slot.start;
            summary.innerHTML = `<span>${copy.selected}</span><strong>${readableDate()} · ${slot.label}</strong><small>${option.title} · ${option.minutes} min · € ${option.priceEur}</small>`;
            details.hidden = false;
            preferencesContinue.hidden = false;
            creatorFieldset.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          slotGrid.append(button);
        }
      } catch {
        if (requestId !== slotRequest) return;
        slotStatus.textContent = copy.error;
      }
    }

    calendarPrevious.addEventListener('click', () => {
      calendarMonth = new Date(Date.UTC(
        calendarMonth.getUTCFullYear(),
        calendarMonth.getUTCMonth() - 1,
        1,
        12,
      ));
      void loadAvailabilityCalendar(true);
    });
    calendarNext.addEventListener('click', () => {
      calendarMonth = new Date(Date.UTC(
        calendarMonth.getUTCFullYear(),
        calendarMonth.getUTCMonth() + 1,
        1,
        12,
      ));
      void loadAvailabilityCalendar(true);
    });
    preferencesContinue.addEventListener('click', () => {
      details.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => {
        form.querySelector<HTMLInputElement>('#customer-name')?.focus({ preventScroll: true });
      }, 450);
    });
    service.addEventListener('change', () => {
      setChoiceVisibility();
      void loadAvailabilityCalendar(true);
    });

    renderCalendar();
    if (preselectedOption) {
      service.value = preselectedOption.id;
      setChoiceVisibility();
      void loadAvailabilityCalendar();
    } else if (requestedCategory === 'studio') {
      void loadAvailabilityCalendar();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const option = selectedOption();
      if (!option || !start.value || !form.reportValidity()) return;
      submit.disabled = true;
      submit.firstChild!.textContent = copy.submitting;
      formError.hidden = true;

      const data = new FormData(form);
      const payload = {
        locale,
        key: option.key,
        category: option.category,
        minutes: option.minutes,
        start: start.value,
        customerName: data.get('customerName'),
        customerEmail: data.get('customerEmail'),
        customerPhone: data.get('customerPhone'),
        creatorScent: data.get('creatorScent') || undefined,
        creatorMusic: data.get('creatorMusic') || undefined,
        creatorBase: option.creatorBase || undefined,
        creatorBack: option.creatorBack ?? undefined,
        creatorFace: option.creatorFace ?? undefined,
        creatorFoot: option.creatorFoot ?? undefined,
        notes: data.get('notes') || undefined,
        website: data.get('website') || undefined,
        consent: data.get('consent') === 'on',
        analyticsSessionId: getAnalyticsSessionId(),
      };

      try {
        const response = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok) {
          if (response.status === 409) {
            formError.textContent = copy.unavailable;
            formError.hidden = false;
            await loadAvailabilityCalendar();
            await loadSlots();
            return;
          }
          throw new Error(result.error);
        }

        reference.textContent = result.booking.reference;
        form.hidden = true;
        confirmation.hidden = false;
        confirmation.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        formError.textContent = copy.error;
        formError.hidden = false;
      } finally {
        submit.disabled = false;
        submit.firstChild!.textContent = copy.submit;
      }
    });

    another.addEventListener('click', () => {
      form.reset();
      calendarMonth = new Date(Date.UTC(
        utcDate(today).getUTCFullYear(),
        utcDate(today).getUTCMonth(),
        1,
        12,
      ));
      date.value = '';
      start.value = '';
      details.hidden = true;
      preferencesContinue.hidden = true;
      slotGrid.replaceChildren();
      slotStatus.textContent = copy.chooseFirst;
      setChoiceVisibility();
      confirmation.hidden = true;
      form.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      void loadAvailabilityCalendar();
    });
  }
</script>

