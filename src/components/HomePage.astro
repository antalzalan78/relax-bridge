---
import { bookingPath, questionnairePath, site, pathFor, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';
import { getServices, homeAlternates, lowestPrice } from '../lib/services';
import { localBusinessSchema, faqSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile-forest.jpg';
import studioImage from '../assets/studio-tilburg.jpg';
import bikeImage from '../assets/home-service-fiets.jpg';
import purpleTowelTexture from '../assets/towel-purple-card.png';
import orangeTowelTexture from '../assets/towel-orange-card.png';
import greenTowelTexture from '../assets/towel-green-section.png';
import approvedLogoWatermark from '../assets/logo-watermark-approved.png';
import Base from '../layouts/Base.astro';
import ServiceCard from './ServiceCard.astro';
import PriceTable from './PriceTable.astro';
import WaveDivider from './WaveDivider.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const studio = await getServices(locale, 'studio');
const home = await getServices(locale, 'home');
const cheapest = lowestPrice([...studio, ...home]);
const bookingHref = bookingPath(locale);

const alternates = homeAlternates();
const path = pathFor(locale);

const jsonLd = [
  localBusinessSchema(locale, d.meta.description),
  faqSchema(d.goodToKnow.items),
];
---

<Base
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">{d.tagline}</span>
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.intro}</p>
        <div class="hero__meta" aria-label={`${d.nav.studio}, ${d.nav.homeService}, Tilburg`}>
          <span>{d.nav.studio}</span>
          <span aria-hidden="true">&middot;</span>
          <span>{d.nav.homeService}</span>
          <span aria-hidden="true">&middot;</span>
          <span>Tilburg</span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={bookingHref}>
            {d.hero.primaryCta}
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href={`#${anchors.prices}`}>
            {d.hero.secondaryCta}
            {cheapest && <span>&nbsp;&middot; {d.prices.from} &euro; {cheapest}</span>}
          </a>
        </div>
      </div>

      <div class="hero__media">
        <div class="hero__arch" aria-hidden="true"></div>
        <Image
          class="hero__profile"
          src={profileImage}
          alt={d.images.profile}
          widths={[480, 800, 1200]}
          sizes="(min-width: 54rem) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__caption">
          <span>{d.heroProfile.name}</span>
          <strong>{d.heroProfile.role}</strong>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <WaveDivider />
  </div>

  <section class="section location-section location-section--studio" id={anchors.services}>
    <div class="wrap">
      <div class="section-heading section-heading--wide services-heading">
        <h2>{d.nav.services}</h2>
      </div>

      <div class="location-showcase">
        <div class="location-showcase__media">
          <Image
            class="location-showcase__image location-showcase__image--studio"
            src={studioImage}
            alt={d.images.studio}
            widths={[640, 960, 1440]}
            sizes="(min-width: 52rem) 54vw, 100vw"
            loading="lazy"
          />
          <span class="location-showcase__number" aria-hidden="true">01</span>
        </div>

        <div class="location-showcase__intro">
          <span class="eyebrow">Relax Bridge · 01</span>
          <h2>{d.options.studio.label}</h2>
          <h3>{d.options.studio.title}</h3>
          <p class="lead">{d.options.studio.body}</p>
          <a class="text-link" href="#studio-services">
            {d.options.studio.cta}<span aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>

      <div class="location-offer" id="studio-services">
        <div class="location-offer__services">
          <span class="detail-label">{d.options.studio.cta}</span>
          <div class="service-list">
            {studio.map((s, index) => <ServiceCard locale={locale} service={s} index={index} />)}
          </div>
        </div>

        <aside class="price-panel price-panel--textured" id={anchors.prices} aria-label={d.prices.studioHeading}>
          <Image
            class="price-panel__texture"
            src={purpleTowelTexture}
            alt=""
            width={640}
            loading="lazy"
            aria-hidden="true"
          />
          <span class="price-panel__number" aria-hidden="true">01</span>
          <PriceTable locale={locale} caption={d.prices.studioHeading} services={studio} />
          <p class="price-panel__note">{d.prices.intro}</p>
        </aside>
      </div>
    </div>
  </section>

  <section
    class="section section--tint location-section location-section--home"
    style={`--section-logo-pattern: url("${approvedLogoWatermark.src}")`}
  >
    <div class="wrap">
      <div class="location-showcase location-showcase--reverse">
        <div class="location-showcase__media">
          <Image
            class="location-showcase__image"
            src={bikeImage}
            alt={d.images.homeService}
            widths={[640, 960, 1440]}
            sizes="(min-width: 52rem) 54vw, 100vw"
            loading="lazy"
          />
          <span class="location-showcase__number" aria-hidden="true">02</span>
        </div>

        <div class="location-showcase__intro">
          <span class="eyebrow">Relax Bridge · 02</span>
          <h2>{d.options.homeService.label}</h2>
          <h3>{d.options.homeService.title}</h3>
          <p class="lead">{d.options.homeService.body}</p>
          <a class="text-link" href="#home-services">
            {d.options.homeService.cta}<span aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>

      <div class="location-offer" id="home-services">
        <div class="location-offer__services">
          <span class="detail-label">{d.options.homeService.cta}</span>
          <div class="service-list">
            {home.map((s, index) => <ServiceCard locale={locale} service={s} index={index} />)}
          </div>
        </div>

        <aside class="price-panel price-panel--textured price-panel--textured--orange" aria-label={d.prices.homeHeading}>
          <Image
            class="price-panel__texture"
            src={orangeTowelTexture}
            alt=""
            width={640}
            loading="lazy"
            aria-hidden="true"
          />
          <span class="price-panel__number" aria-hidden="true">02</span>
          <PriceTable locale={locale} caption={d.prices.homeHeading} services={home} />
          <p class="price-panel__note">{d.prices.intro}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="wrap section knowledge-grid">
    <div class="knowledge-grid__intro">
      <span class="eyebrow">Relax Bridge</span>
      <h2>{d.goodToKnow.heading}</h2>
      <a class="btn btn--ghost" href={questionnairePath(locale)}>
        {d.goodToKnow.questionnaireCta}
      </a>
    </div>
    <div>
      {
        d.goodToKnow.items.map((item) => (
          <details class="faq">
            <summary>{item.title}</summary>
            <div class="faq__body">{item.body}</div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="booking-section" id={anchors.contact}>
    <Image
      class="booking-section__texture"
      src={greenTowelTexture}
      alt=""
      width={1600}
      loading="lazy"
      aria-hidden="true"
    />
    <div class="booking-section__overlay" aria-hidden="true"></div>
    <div class="wrap booking-section__grid">
      <div>
        <span class="eyebrow">{d.tagline}</span>
        <h2>{d.contact.heading}</h2>
        <p class="lead">{d.contact.intro}</p>
        <div class="booking-section__actions">
          <a
            class="btn btn--light"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            {d.contact.whatsappCta}<span aria-hidden="true">&rarr;</span>
          </a>
          <a
            class="btn btn--review"
            href={site.googleReview}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">★</span>{d.contact.googleReviewCta}
          </a>
        </div>
      </div>

      <div class="booking-section__details">
        <div>
          <span class="detail-label">{d.contact.whatsapp}</span>
          <a href={site.whatsapp} rel="noopener">{site.phoneDisplay}</a>
        </div>
        <div>
          <span class="detail-label">{d.contact.area}</span>
          <p>{d.contact.areaBody}</p>
        </div>
        <div>
          <span class="detail-label">{d.contact.follow}</span>
          <p>
            <a href={site.social.instagram} rel="noopener">Instagram</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={site.social.facebook} rel="noopener">Facebook</a>
          </p>
        </div>
        <div>
          <span class="detail-label">{d.contact.googleReview}</span>
          <a href={site.googleReview} target="_blank" rel="noopener noreferrer">
            {d.contact.googleReviewCta}<span aria-hidden="true"> &rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
