---
import {
  aboutPath,
  bookingPath,
  bookingChoicePath,
  blogPath,
  massageCreatorPath,
  questionnairePath,
  site,
  pathFor,
  treatmentsPath,
  type Locale,
} from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';
import { studioBookingText } from '../i18n/studio-booking';
import { getServices, homeAlternates } from '../lib/services';
import { localBusinessSchema, faqSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import studioImage from '../assets/studio-tilburg.jpg';
import Base from '../layouts/Base.astro';
import WaveDivider from './WaveDivider.astro';
import Reviews from './Reviews.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const studioCopy = studioBookingText(locale);

const studio = await getServices(locale, 'studio');
const bookingHref = bookingChoicePath(locale);
const studioReadyBookingHref = `${bookingPath(locale)}?category=studio`;
const creatorHref = massageCreatorPath(locale);

const alternates = homeAlternates();
const path = pathFor(locale);

const jsonLd = [
  localBusinessSchema(locale, d.meta.description),
  faqSchema(d.goodToKnow.items),
];
const designCopy = {
  nl: {
    focus: 'Ik merk het op.', connect: 'Ik neem het serieus.', balance: 'Ik doe er iets mee.',
    googleRead: 'Lees Google-beoordelingen', founder: 'Oprichter en masseuse', about: 'Leer mij kennen',
    details: ['Muziek of stilte', 'Met of zonder geur', 'Een massage op maat', 'Een rustige, persoonlijke plek'],
  },
  en: {
    focus: 'I notice it.', connect: 'I take it seriously.', balance: 'I act on it.',
    googleRead: 'Read Google reviews', founder: 'Founder and massage therapist', about: 'Get to know me',
    details: ['Music or silence', 'With or without scent', 'A tailored massage', 'A calm, personal space'],
  },
  hu: {
    focus: 'Észreveszem.', connect: 'Komolyan veszem.', balance: 'Teszek érte.',
    googleRead: 'Google-vélemények olvasása', founder: 'alapító és masszőr', about: 'Ismerj meg',
    details: ['Zene vagy csend', 'Illattal vagy illatmentesen', 'Rád szabott kezelés', 'Nyugodt, személyes környezet'],
  },
}[locale];
---

<Base
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
  quietBackdrop
>
  <section class="wrap hero hero--with-introduction">
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">{d.hero.eyebrow}</span>
        <h1>{d.hero.title}</h1>
        <p class="lead hero__intro--desktop">{d.hero.intro}</p>
        <p class="lead hero__intro--mobile">{d.hero.mobileIntro}</p>
        <div class="homepage-philosophy" aria-label="Relax Bridge">
          <span><strong>foCus</strong>{designCopy.focus}</span>
          <span><strong>ConneCt</strong>{designCopy.connect}</span>
          <span><strong>balanCe</strong>{designCopy.balance}</span>
        </div>
        <div class="homepage-founder">
          <h2>{d.introduction.homeTitle}</h2>
          <p>{d.introduction.homeBody}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={bookingHref}>
            {d.hero.primaryCta}
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href={aboutPath(locale)}>{designCopy.about}<span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <figure class="homepage-photo">
        <div class="homepage-photo__clip">
          <Image src={studioImage} alt={d.images.studio} widths={[480, 720, 960]} sizes="(min-width: 52rem) 44vw, 100vw" loading="eager" fetchpriority="high" />
        </div>
        <figcaption><strong>Brigitta</strong><span>{designCopy.founder}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap treatment-choice" id={anchors.choice} aria-labelledby="treatment-choice-title">
    <span class="eyebrow">{d.choice.eyebrow}</span>
    <p class="lead treatment-choice__prompt">{d.choice.intro}</p>
    <h2 id="treatment-choice-title">{d.choice.heading}</h2>
    <div class="treatment-choice__cards">
      <article class="treatment-choice__card treatment-choice__card--creator">
        <svg class="treatment-choice__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/><path d="M9 4v4M16 10v4M7 16v4"/></svg>
        <span class="eyebrow">01 · {d.choice.creatorLabel}</span>
        <h3>{d.choice.creatorTitle}</h3>
        <p>{d.choice.creatorBody}</p>
        <a class="btn btn--primary" href={creatorHref}>{d.choice.creatorCta}<span aria-hidden="true">&rarr;</span></a>
      </article>
      <article class="treatment-choice__card">
        <svg class="treatment-choice__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-9M12 16c-4 0-7-2-7-6 4 0 7 2 7 6ZM12 13c0-4 2-7 6-8 1 4-1 7-6 8ZM7 21h10"/></svg>
        <span class="eyebrow">02 · {d.choice.readyLabel}</span>
        <h3>{d.choice.readyTitle}</h3>
        <p>{d.choice.readyBody}</p>
        <a class="btn btn--ghost" href={treatmentsPath(locale)}>{d.choice.readyCta}<span aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
    <div class="treatment-choice__details">{designCopy.details.map((item) => <span>{item}</span>)}</div>
    <p class="treatment-choice__shared-note">{d.choice.sharedNote}</p>
  </section>

  <div class="wrap"><WaveDivider animate /></div>

  <section class="section location-section location-section--studio" id={anchors.services}>
    <div class="wrap">
      <div class="section-heading section-heading--wide services-heading">
        <h2>{d.nav.services}</h2>
      </div>

      <section class="studio-offer-group" id="studio-services">
        <article class="creator-spotlight" aria-labelledby="creator-spotlight-title">
          <div class="creator-spotlight__intro">
            <span class="eyebrow">{d.options.studio.personalization.spotlightEyebrow}</span>
            <h2 id="creator-spotlight-title">Massage Creator</h2>
            <p class="lead">{d.options.studio.personalization.spotlightIntro}</p>
            <a class="btn btn--primary" href={creatorHref}>
              {d.options.studio.personalization.spotlightCta}<span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ol class="creator-spotlight__steps">
            {d.options.studio.personalization.spotlightSteps.map((step, index) => (
              <li>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{step.title}</h3><p>{step.body}</p></div>
              </li>
            ))}
          </ol>
        </article>

        <header class="studio-offer-group__heading" id="ready-treatments">
          <div class="studio-offer-group__heading-copy">
            <h2>{studioCopy.readyHeading}</h2>
          </div>
          <a class="btn btn--primary" href={studioReadyBookingHref}>
            {d.hero.primaryCta}<span aria-hidden="true">&rarr;</span>
          </a>
        </header>

        <div class="studio-treatment-list studio-treatment-list--with-prices">
            {studio.map((service, index) => {
              return (
                <article class="studio-treatment-card">
                  <span class="studio-treatment-card__number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="studio-treatment-card__body">
                    <h3>{service.data.title}</h3>
                    <p class="studio-treatment-card__summary">{service.data.summary}</p>
                  </div>
                  <table class="studio-treatment-card__prices">
                    <caption class="visually-hidden">{service.data.title}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{d.prices.duration}</th>
                        <th scope="col">{d.prices.price}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {service.data.prices.map((price) => (
                        <tr>
                          <td>{price.minutes} {d.prices.minutes}</td>
                          <td>&euro; {price.eur}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </article>
              );
            })}
        </div>
        <p class="studio-offer-group__payment-note" id={anchors.prices}>{d.prices.intro}</p>
      </section>

    </div>
  </section>

  <Reviews locale={locale} compact />

  <section class="wrap home-blog-promo" aria-labelledby="home-blog-title">
    <div>
      <span class="eyebrow">{d.nav.blog}</span>
      <h2 id="home-blog-title">{locale === 'hu' ? 'Egy kis idő a felfedezésre.' : locale === 'nl' ? 'Even tijd om te ontdekken.' : 'Take a moment to explore.'}</h2>
      <p>{locale === 'hu' ? 'Történetek, gyakorlati tudnivalók és inspiráció a masszázs világából.' : locale === 'nl' ? 'Verhalen, praktische tips en inspiratie uit de wereld van massage.' : 'Stories, practical tips and inspiration from the world of massage.'}</p>
    </div>
    <a class="btn btn--ghost" href={blogPath(locale)}>{locale === 'hu' ? 'Témák megtekintése' : locale === 'nl' ? 'Bekijk de onderwerpen' : 'Explore the topics'} <span aria-hidden="true">→</span></a>
  </section>

  <section class="wrap section knowledge-grid" id="practical-info">
    <div class="knowledge-grid__intro">
      <span class="eyebrow">Relax Bridge</span>
      <h2>{d.goodToKnow.heading}</h2>
      <p class="knowledge-grid__summary">{d.goodToKnow.practicalSummary}</p>
      <a class="btn btn--ghost" href={questionnairePath(locale)}>
        {d.goodToKnow.questionnaireCta}
      </a>
    </div>
    <div>
      {
        d.goodToKnow.items.map((item) => (
          <details class="faq">
            <summary>{item.title}</summary>
            <div class="faq__body">{item.body}</div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="booking-section" id={anchors.contact}>
    <div class="wrap booking-section__grid">
      <div>
        <span class="eyebrow">{d.tagline}</span>
        <h2>{d.contact.heading}</h2>
        <p class="lead">{d.contact.intro}</p>
        <div class="booking-section__actions">
          <a
            class="btn btn--primary"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            {d.contact.whatsappCta}<span aria-hidden="true">&rarr;</span>
          </a>
          <a
            class="btn btn--review"
            href={site.googleReview}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">★</span>{d.contact.googleReviewCta}
          </a>
          <a class="btn btn--review" href={site.googleReviews} target="_blank" rel="noopener noreferrer">{designCopy.googleRead}<span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="booking-section__details">
        <div>
          <span class="detail-label">{d.contact.whatsapp}</span>
          <a href={site.whatsapp} rel="noopener">{site.phoneDisplay}</a>
        </div>
        <div>
          <span class="detail-label">{d.contact.area}</span>
          <p>{d.contact.areaBody}</p>
        </div>
        <div>
          <span class="detail-label">{d.contact.follow}</span>
          <p>
            <a href={site.social.instagram} rel="noopener">Instagram</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={site.social.facebook} rel="noopener">Facebook</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={site.introductionVideo} target="_blank" rel="noopener noreferrer">YouTube</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero--with-introduction, .treatment-choice, .location-section > .wrap, .home-blog-promo, .knowledge-grid, .booking-section__grid { max-width: 88rem; }
  .location-showcase__practical {
    margin: 0.8rem 0 0;
  }

  #practical-info {
    scroll-margin-top: 6rem;
  }

  .knowledge-grid__summary {
    max-width: 22rem;
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }

  .hero--with-introduction { padding-block: clamp(2rem, 4vw, 3rem); }
  .hero--with-introduction .hero__grid { gap: clamp(1.5rem, 3vw, 3rem); }
  .hero--with-introduction .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(.8rem, 1.3vw, 1.25rem); }
  .hero--with-introduction .hero__copy > * { margin-block: 0; }
  .hero--with-introduction .hero__copy h1 { max-width: 18ch; font-size: clamp(2.8rem, 4vw, 3.5rem); line-height: 1.1; }
  .hero--with-introduction .hero__copy .lead { max-width: 58ch; font-size: clamp(1rem, 1.3vw, 1.13rem); }
  .homepage-philosophy { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; gap: .85rem; }
  .homepage-philosophy span { display: grid; color: var(--ink-soft); font-size: .8rem; line-height: 1.35; }
  .homepage-philosophy strong { color: var(--orange-accent); font-family: 'Iowan Old Style', Georgia, serif; font-size: clamp(1.25rem, 2vw, 1.55rem); font-weight: 500; }
  .homepage-philosophy span:nth-child(2) strong { color: var(--pine); }
  .homepage-philosophy span:nth-child(3) strong { color: var(--purple-accent); }
  .homepage-founder { width: 100%; padding-top: 1rem; border-top: 1px solid var(--border); }
  .homepage-founder h2 { margin: 0 0 .25rem; font-size: clamp(1.35rem, 2vw, 1.8rem); }
  .homepage-founder p { max-width: 55ch; margin: 0; color: var(--ink-soft); font-size: .95rem; }
  .hero--with-introduction .btn-row { margin-top: .3rem; }
  .homepage-photo { position: relative; margin: 0; min-width: 0; }
  .homepage-photo__clip { height: clamp(20rem, 30vw, 26rem); overflow: hidden; border-radius: 45% 42% 31% 35% / 47% 40% 36% 30%; background: #e0e4d4; }
  .homepage-photo__clip img { width: 100%; height: 100%; object-fit: cover; object-position: 47% 0%; }
  .homepage-photo figcaption { position: absolute; right: 1.1rem; bottom: 1.1rem; display: grid; padding: .7rem 1.4rem; border: 1px solid rgb(255 255 255 / .5); border-radius: 99px; background: rgb(255 250 240 / .96); box-shadow: var(--shadow-soft); line-height: 1.3; }
  .homepage-photo figcaption strong { font-size: 1.1rem; }
  .homepage-photo figcaption span { color: var(--ink-soft); font-size: .78rem; }
  .home-blog-promo { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; padding-block: clamp(2.5rem, 5vw, 4rem); border-block: 1px solid var(--border); }
  .home-blog-promo h2 { margin: .5rem 0; }
  .home-blog-promo p { margin: 0; color: var(--ink-soft); }
  .treatment-choice { padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem); }
  .treatment-choice > .eyebrow { display: none; }
  .treatment-choice__prompt { max-width: 42rem; margin: .9rem auto .4rem; text-align: center; }
  .treatment-choice > h2 { max-width: none; margin: .25rem 0 1.4rem; text-align: center; font-size: clamp(2rem, 3vw, 2.7rem); }
  .treatment-choice__cards { margin-top: 1.25rem; }
  .treatment-choice__card { position: relative; min-height: 15rem; padding: clamp(1.25rem, 2.5vw, 2rem); border-radius: 1.6rem; box-shadow: 0 5px 16px rgb(73 59 27 / .05); }
  .treatment-choice__card .eyebrow { color: var(--pine-dark); }
  .treatment-choice__card h3 { max-width: 17ch; font-size: clamp(1.6rem, 2.4vw, 2rem); }
  .treatment-choice__card .btn { min-height: 2.8rem; font-size: .9rem; }
  .treatment-choice__icon { position: absolute; top: 1.1rem; right: 1.35rem; width: 1.9rem; height: 1.9rem; color: var(--pine); }
  .treatment-choice__details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 1.5rem 1rem .5rem; }
  .treatment-choice__details span { display: flex; align-items: center; justify-content: center; min-height: 2.5rem; padding: .3rem .6rem; color: var(--ink-soft); font-size: .8rem; text-align: center; }
  .treatment-choice__details span + span { border-left: 1px solid var(--border); }
  .treatment-choice__shared-note { margin: 1.25rem 0 0; color: var(--ink-soft); font-size: .9rem; text-align: center; }

  .hero__intro--mobile {
    display: none;
  }

  .hero--with-introduction { position: relative; isolation: isolate; overflow: clip; }
  .hero--with-introduction::before,
  .hero--with-introduction::after {
    position: absolute;
    z-index: -1;
    width: min(55vw, 34rem);
    height: 9rem;
    border-bottom: .38rem solid;
    border-radius: 50%;
    pointer-events: none;
    content: '';
  }
  .hero--with-introduction::before { left: -11rem; bottom: 2rem; border-color: rgb(216 126 42 / .27); transform: rotate(12deg); }
  .hero--with-introduction::after { right: -10rem; bottom: 6rem; border-color: rgb(130 80 155 / .2); transform: rotate(-9deg); }

  .knowledge-grid { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .knowledge-grid :global(.faq) { margin-bottom: .7rem; padding-inline: 1.2rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .knowledge-grid :global(.faq:last-child) { border-bottom: 1px solid var(--border); }
  .knowledge-grid :global(.faq summary) { padding-block: 1rem; }
  .booking-section { padding-block: clamp(2.5rem, 5vw, 3.5rem); border-block: 1px solid #dedac9; background: linear-gradient(115deg, #edf1e3 0%, #f7ead8 59%, #eee5f0 100%); color: var(--ink); }
  .booking-section::before, .booking-section::after { display: none; }
  .booking-section .eyebrow { color: var(--clay-dark); }
  .booking-section .lead { color: var(--ink-soft); opacity: 1; }
  .booking-section__details { border-top-color: var(--border); }
  .booking-section__details > div { border-bottom-color: var(--border); }
  .booking-section__details .detail-label { color: var(--clay-dark); opacity: 1; }
  .booking-section__details a, .booking-section__details p { color: var(--ink); }
  .booking-section .btn--review { border-color: var(--border); background: var(--surface); color: var(--ink); }
  .booking-section .btn--review:hover { border-color: var(--pine); background: var(--pine-soft); }

  @media (max-width: 47.99rem) {
    .homepage-photo__clip { height: clamp(15rem, 59vw, 23rem); }
    .treatment-choice__cards { gap: .8rem; }
    .treatment-choice__card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .25rem .8rem; min-height: 0; padding: 1rem 1.1rem; border-radius: 1.2rem; }
    .treatment-choice__icon, .treatment-choice__card .eyebrow { display: none; }
    .treatment-choice__card h3 { grid-column: 1; margin: 0; font-family: inherit; font-size: 1.05rem; font-weight: 700; letter-spacing: 0; }
    .treatment-choice__card p { grid-column: 1; margin: 0; font-size: .76rem; line-height: 1.4; }
    .treatment-choice__card .btn { grid-column: 2; grid-row: 1 / 3; width: 2.75rem; min-height: 2.75rem; padding: 0; overflow: hidden; font-size: 0; }
    .treatment-choice__card .btn span { font-size: 1rem; }
    .treatment-choice__details { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; margin-inline: 0; }
    .treatment-choice__details span { justify-content: flex-start; text-align: left; }
    .treatment-choice__details span + span { border-left: 0; }
    #practical-info {
      scroll-margin-top: 9rem;
    }

    .hero__intro--desktop {
      display: none;
    }

    .hero__intro--mobile {
      display: block;
    }

    .hero--with-introduction {
      padding-block: clamp(1.75rem, 5vw, 2.75rem) clamp(2rem, 5vw, 3rem);
    }

    .hero--with-introduction .hero__grid {
      gap: clamp(2rem, 5vw, 3rem);
    }

    .hero--with-introduction .hero__copy h1 { max-width: 20ch; font-size: clamp(2.2rem, 8vw, 3rem); line-height: 1.1; }

    .hero--with-introduction .hero__copy .lead {
      margin-top: 0.75rem;
      font-size: clamp(1rem, 2.8vw, 1.13rem);
      line-height: 1.48;
    }

    .hero--with-introduction .hero__meta {
      margin-top: 1rem;
    }

    .hero--with-introduction .btn-row {
      margin-top: 1.2rem;
    }
  }
  @media (max-width: 26rem) {
    .homepage-philosophy { gap: .35rem; }
    .homepage-philosophy strong { font-size: 1.05rem; }
    .homepage-philosophy span { font-size: .7rem; }
    .hero--with-introduction .btn-row .btn { flex: 1 1 100%; }
  }
</style>
