---
import { site, pathFor, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';
import { getServices, homeAlternates, lowestPrice } from '../lib/services';
import { localBusinessSchema, faqSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import studioImage from '../assets/studio-tilburg.jpg';
import bikeImage from '../assets/home-service-fiets.jpg';
import Base from '../layouts/Base.astro';
import ServiceCard from './ServiceCard.astro';
import PriceTable from './PriceTable.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const studio = await getServices(locale, 'studio');
const home = await getServices(locale, 'home');
const cheapest = lowestPrice([...studio, ...home]);

const alternates = homeAlternates();
const path = pathFor(locale);

const jsonLd = [
  localBusinessSchema(locale, d.meta.description),
  faqSchema(d.goodToKnow.items),
];
---

<Base
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="hero__grid">
      <div>
        <span class="eyebrow">{d.tagline}</span>
        {/* Egyetlen h1 az oldalon, benne a szolgaltatas es a varos. */}
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.intro}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`#${anchors.contact}`}>
            {d.hero.primaryCta}
          </a>
          <a class="btn btn--ghost" href={`#${anchors.prices}`}>
            {d.hero.secondaryCta}
            {cheapest && <span>&nbsp;&middot; {d.prices.from} &euro; {cheapest}</span>}
          </a>
        </div>
      </div>
      <div class="hero__media">
        <Image
          src={studioImage}
          alt={d.images.studio}
          widths={[480, 800, 1200]}
          sizes="(min-width: 54rem) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="wrap section" id={anchors.services}>
    <div class="grid grid--2">
      <div class="card">
        <span class="eyebrow">{d.options.studio.label}</span>
        <h2>{d.options.studio.title}</h2>
        <p>{d.options.studio.body}</p>
      </div>
      <div class="card">
        <Image
          class="card__media"
          src={bikeImage}
          alt={d.images.homeService}
          widths={[400, 700]}
          sizes="(min-width: 40rem) 30vw, 90vw"
          loading="lazy"
        />
        <span class="eyebrow">{d.options.homeService.label}</span>
        <h2>{d.options.homeService.title}</h2>
        <p>{d.options.homeService.body}</p>
      </div>
    </div>

    <h2 style="margin-top:3rem">{d.nav.studio}</h2>
    <div class="grid grid--2">
      {studio.map((s) => <ServiceCard locale={locale} service={s} />)}
    </div>

    <h2 style="margin-top:3rem">{d.nav.homeService}</h2>
    <div class="grid grid--2">
      {home.map((s) => <ServiceCard locale={locale} service={s} />)}
    </div>
  </section>

  <section class="wrap section" id={anchors.prices}>
    <h2>{d.prices.heading}</h2>
    <p class="lead prose">{d.prices.intro}</p>
    <div class="grid grid--2" style="margin-top:2rem">
      <PriceTable
        locale={locale}
        caption={d.prices.studioHeading}
        services={studio}
      />
      <PriceTable
        locale={locale}
        caption={d.prices.homeHeading}
        services={home}
      />
    </div>
  </section>

  <section class="wrap wrap--narrow section">
    <h2>{d.goodToKnow.heading}</h2>
    {
      d.goodToKnow.items.map((item) => (
        <details class="faq">
          <summary>{item.title}</summary>
          <div class="faq__body">{item.body}</div>
        </details>
      ))
    }
    <div class="btn-row">
      <a class="btn btn--ghost" href={site.giftCardUrl} rel="noopener">
        {d.goodToKnow.giftCardCta}
      </a>
    </div>
  </section>

  <section class="wrap section" id={anchors.contact}>
    <h2>{d.contact.heading}</h2>
    <p class="lead prose">{d.contact.intro}</p>

    <div class="grid grid--3" style="margin-top:2rem">
      <div class="card">
        <h3>{d.contact.whatsapp}</h3>
        <p>{site.phoneDisplay}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.whatsapp} rel="noopener">
            {d.contact.whatsappCta}
          </a>
        </div>
      </div>

      <div class="card">
        <h3>{d.contact.area}</h3>
        <p>{d.contact.areaBody}</p>
      </div>

      <div class="card">
        <h3>{d.contact.follow}</h3>
        <p>
          <a href={site.social.instagram} rel="noopener">Instagram</a> &middot;{' '}
          <a href={site.social.facebook} rel="noopener">Facebook</a>
        </p>
        <h3 style="margin-top:1rem">{d.contact.playlists}</h3>
        <p>
          <a href={site.playlists.spotify} rel="noopener">Spotify</a> &middot;{' '}
          <a href={site.playlists.youtubeMusic} rel="noopener">YouTube Music</a>
        </p>
      </div>
    </div>
  </section>
</Base>
