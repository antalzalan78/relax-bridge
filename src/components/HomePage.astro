---
import { bookingPath, site, pathFor, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';
import { getServices, homeAlternates, lowestPrice } from '../lib/services';
import { localBusinessSchema, faqSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import studioImage from '../assets/studio-tilburg.jpg';
import bikeImage from '../assets/home-service-fiets.jpg';
import Base from '../layouts/Base.astro';
import ServiceCard from './ServiceCard.astro';
import PriceTable from './PriceTable.astro';
import WaveDivider from './WaveDivider.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const studio = await getServices(locale, 'studio');
const home = await getServices(locale, 'home');
const cheapest = lowestPrice([...studio, ...home]);
const bookingHref = bookingPath(locale);

const alternates = homeAlternates();
const path = pathFor(locale);

const jsonLd = [
  localBusinessSchema(locale, d.meta.description),
  faqSchema(d.goodToKnow.items),
];
---

<Base
  locale={locale}
  title={d.meta.title}
  description={d.meta.description}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">{d.tagline}</span>
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.intro}</p>
        <div class="hero__meta" aria-label={`${d.nav.studio}, ${d.nav.homeService}, Tilburg`}>
          <span>{d.nav.studio}</span>
          <span aria-hidden="true">&middot;</span>
          <span>{d.nav.homeService}</span>
          <span aria-hidden="true">&middot;</span>
          <span>Tilburg</span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={bookingHref}>
            {d.hero.primaryCta}
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href={`#${anchors.prices}`}>
            {d.hero.secondaryCta}
            {cheapest && <span>&nbsp;&middot; {d.prices.from} &euro; {cheapest}</span>}
          </a>
        </div>
      </div>

      <div class="hero__media">
        <div class="hero__arch" aria-hidden="true"></div>
        <Image
          src={studioImage}
          alt={d.images.studio}
          widths={[480, 800, 1200]}
          sizes="(min-width: 54rem) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__caption">
          <span>{d.options.studio.label}</span>
          <strong>Tilburg</strong>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <WaveDivider />
  </div>

  <section class="wrap section place-section" id={anchors.services}>
    <div class="section-heading section-heading--wide">
      <span class="eyebrow">Relax Bridge</span>
      <h2>
        {d.options.studio.label}
        <span class="heading-bridge" aria-hidden="true">&harr;</span>
        {d.options.homeService.label}
      </h2>
    </div>

    <div class="place-bridge">
      <article class="place-panel place-panel--studio">
        <span class="place-panel__number" aria-hidden="true">01</span>
        <div class="place-panel__content">
          <span class="eyebrow">{d.options.studio.label}</span>
          <h3>{d.options.studio.title}</h3>
          <p>{d.options.studio.body}</p>
          <a class="text-link" href="#studio-services">
            {d.options.studio.cta}<span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>

      <article class="place-panel place-panel--home">
        <Image
          class="place-panel__image"
          src={bikeImage}
          alt={d.images.homeService}
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 50vw, 100vw"
          loading="lazy"
        />
        <div class="place-panel__shade" aria-hidden="true"></div>
        <span class="place-panel__number" aria-hidden="true">02</span>
        <div class="place-panel__content">
          <span class="eyebrow">{d.options.homeService.label}</span>
          <h3>{d.options.homeService.title}</h3>
          <p>{d.options.homeService.body}</p>
          <a class="text-link" href="#home-services">
            {d.options.homeService.cta}<span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
    </div>

    <div class="treatment-block" id="studio-services">
      <div class="treatment-block__heading">
        <span class="eyebrow">01</span>
        <h2>{d.nav.studio}</h2>
      </div>
      <div class="service-list">
        {studio.map((s, index) => <ServiceCard locale={locale} service={s} index={index} />)}
      </div>
    </div>

    <div class="treatment-block" id="home-services">
      <div class="treatment-block__heading">
        <span class="eyebrow">02</span>
        <h2>{d.nav.homeService}</h2>
      </div>
      <div class="service-list">
        {home.map((s, index) => <ServiceCard locale={locale} service={s} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint" id={anchors.prices}>
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Relax Bridge</span>
        <h2>{d.prices.heading}</h2>
        <p class="lead prose">{d.prices.intro}</p>
      </div>
      <div class="price-grid">
        <div class="price-panel">
          <span class="price-panel__number" aria-hidden="true">01</span>
          <PriceTable locale={locale} caption={d.prices.studioHeading} services={studio} />
        </div>
        <div class="price-panel price-panel--dark">
          <span class="price-panel__number" aria-hidden="true">02</span>
          <PriceTable locale={locale} caption={d.prices.homeHeading} services={home} />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section knowledge-grid">
    <div class="knowledge-grid__intro">
      <span class="eyebrow">Relax Bridge</span>
      <h2>{d.goodToKnow.heading}</h2>
      <a class="btn btn--ghost" href={site.giftCardUrl} rel="noopener">
        {d.goodToKnow.giftCardCta}
      </a>
    </div>
    <div>
      {
        d.goodToKnow.items.map((item) => (
          <details class="faq">
            <summary>{item.title}</summary>
            <div class="faq__body">{item.body}</div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="booking-section" id={anchors.contact}>
    <div class="wrap booking-section__grid">
      <div>
        <span class="eyebrow">{d.tagline}</span>
        <h2>{d.contact.heading}</h2>
        <p class="lead">{d.contact.intro}</p>
        <a class="btn btn--light" href={bookingHref}>
          {d.contact.whatsappCta}<span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="booking-section__details">
        <div>
          <span class="detail-label">{d.contact.whatsapp}</span>
          <a href={site.whatsapp} rel="noopener">{site.phoneDisplay}</a>
        </div>
        <div>
          <span class="detail-label">{d.contact.area}</span>
          <p>{d.contact.areaBody}</p>
        </div>
        <div>
          <span class="detail-label">{d.contact.follow}</span>
          <p>
            <a href={site.social.instagram} rel="noopener">Instagram</a>
            <span aria-hidden="true"> &middot; </span>
            <a href={site.social.facebook} rel="noopener">Facebook</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
