---
import { Image } from 'astro:assets';
import portrait from '../assets/profile-forest.jpg';
import studio from '../assets/studio-tilburg.jpg';
import { aboutPath, bookingChoicePath, site, type Locale } from '../data/site';
import { t } from '../i18n';
import Base from '../layouts/Base.astro';
import Reviews from './Reviews.astro';

interface Props { locale: Locale }

const { locale } = Astro.props;
const d = t(locale);
const path = aboutPath(locale);
const alternates = { nl: aboutPath('nl'), en: aboutPath('en'), hu: aboutPath('hu') };
const aboutLead = d.introduction.paragraphs[0].replace(/^(Brigitta vagyok\.|Ik ben Brigitta\.|I’m Brigitta\.)\s*/, '');
const philosophy = {
  nl: { title: 'Aandacht is de eerste stap.', body: 'Een massage is één van de manieren om bewust voor jezelf te zorgen. Bij Relax Bridge begint dat met aandacht voor wat jij nodig hebt.', focus: 'Ik merk het op.', connect: 'Ik neem het serieus.', balance: 'Ik doe er iets mee.' },
  en: { title: 'Attention is the first step.', body: 'A massage is one of many ways to care for yourself. At Relax Bridge, it starts with noticing what you need.', focus: 'I notice it.', connect: 'I take it seriously.', balance: 'I act on it.' },
  hu: { title: 'A figyelem az első lépés.', body: 'A masszázs az önmagunkról való gondoskodás egyik lehetősége. A Relax Bridge-nél ez azzal kezdődik, hogy figyelünk arra, mire van szükséged.', focus: 'Észreveszem.', connect: 'Komolyan veszem.', balance: 'Teszek érte.' },
}[locale];
---

<Base
  locale={locale}
  title={`${d.introduction.title} | Relax Bridge`}
  description={d.introduction.paragraphs[0]}
  path={path}
  alternates={alternates}
>
  <section class="wrap about-page">
    <div class="about-page__intro">
      <div>
        <span class="eyebrow">{d.introduction.title} · Relax Bridge</span>
        <h1>{locale === 'hu' ? 'Brigitta vagyok.' : locale === 'nl' ? 'Ik ben Brigitta.' : 'I’m Brigitta.'}</h1>
        <p class="lead">{aboutLead}</p>
        <p>{d.introduction.paragraphs[1]}</p>
        <p>{d.introduction.paragraphs[2]}</p>
        <a class="btn btn--ghost" href={site.introductionVideo} target="_blank" rel="noopener noreferrer">{d.introduction.videoCta}<span aria-hidden="true">↗</span></a>
        <a class="btn btn--primary" href={bookingChoicePath(locale)}>{d.hero.primaryCta}<span aria-hidden="true">&rarr;</span></a>
      </div>
      <Image src={portrait} alt={d.images.profile} widths={[480, 720, 960]} sizes="(min-width: 52rem) 40vw, 100vw" loading="eager" />
    </div>

    <section class="about-page__philosophy" aria-labelledby="about-philosophy-title">
      <h2 id="about-philosophy-title">{philosophy.title}</h2>
      <div>
        <p>{philosophy.body}</p>
        <div class="about-page__three-words">
          <span><strong>foCus</strong>{philosophy.focus}</span>
          <span><strong>ConneCt</strong>{philosophy.connect}</span>
          <span><strong>balanCe</strong>{philosophy.balance}</span>
        </div>
      </div>
    </section>

    <Reviews locale={locale} />

    <div class="about-page__studio">
      <Image src={studio} alt={d.images.studio} widths={[480, 720, 960]} sizes="(min-width: 52rem) 42vw, 100vw" loading="lazy" />
      <div>
        <span class="eyebrow">Tilburg–Reeshof</span>
        <h2>{d.options.studio.location.title}</h2>
        <p>{d.options.studio.location.body}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-page { padding-block: clamp(3rem, 6vw, 6rem); }
  .about-page__intro, .about-page__studio { display: grid; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .about-page__intro h1 { font-size: clamp(3.15rem, 5vw, 4.5rem); }
  .about-page__studio { margin-top: clamp(4rem, 8vw, 8rem); }
  .about-page img { width: 100%; border-radius: var(--radius-lg); object-fit: cover; box-shadow: var(--shadow-soft); }
  .about-page__intro img { max-height: 38rem; border-radius: 38% var(--radius-lg) var(--radius-lg) var(--radius-lg) / 22% var(--radius-lg) var(--radius-lg) var(--radius-lg); }
  .about-page__studio img { max-height: 30rem; }
  .about-page p { max-width: 58ch; color: var(--ink-soft); }
  .about-page__philosophy { display: grid; gap: clamp(1.25rem, 4vw, 4rem); margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--pine-soft); }
  .about-page__philosophy h2 { margin: 0; font-size: clamp(1.8rem, 2.5vw, 2.5rem); }
  .about-page__philosophy p { margin: 0; color: var(--ink); }
  .about-page__three-words { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .about-page__three-words span { display: grid; gap: .25rem; color: var(--ink-soft); font-size: .88rem; }
  .about-page__three-words strong { color: var(--orange-accent); font-family: 'Iowan Old Style', Georgia, serif; font-size: 1.35rem; font-weight: 600; }
  .about-page__three-words span:nth-child(2) strong { color: var(--pine-dark); }
  .about-page__three-words span:nth-child(3) strong { color: var(--purple-accent); }
  .about-page .btn { margin-top: 1rem; }
  .about-page__intro .btn + .btn { margin-left: .6rem; }
  @media (max-width: 32rem) { .about-page__intro .btn { width: 100%; justify-content: center; } .about-page__intro .btn + .btn { margin-left: 0; } }
  @media (min-width: 52rem) {
    .about-page__intro { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
    .about-page__studio { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .about-page__intro img { order: -1; }
    .about-page__philosophy { grid-template-columns: 1fr 1.5fr; }
    .about-page__three-words { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .about-page__studio img { order: 2; }
  }
</style>
