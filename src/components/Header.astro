---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import logoWordmark from '../assets/logo-wordmark.png';
import { bookingPath, questionnairePath, site, locales, pathFor, localeNames, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const d = t(locale);
const home = pathFor(locale);
const bookingHref = bookingPath(locale);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={home}>
      {/* A nev mellette all, ezert a jel dekoraciokent ures alt-ot kap. */}
      <span class="brand__mark" aria-hidden="true">
        <Image
          class="brand__mark-image"
          src={logoMark}
          alt=""
          width={70}
          loading="eager"
        />
      </span>
      <span class="brand__name">
        <Image
          class="brand__wordmark"
          src={logoWordmark}
          alt={site.name}
          width={190}
          loading="eager"
        />
      </span>
    </a>

    <nav class="nav" aria-label={d.nav.menu}>
      <a href={`${home}#${anchors.services}`}>{d.nav.studio}</a>
      <a href={`${home}#${anchors.prices}`}>{d.nav.prices}</a>
      <a href={`${home}#${anchors.contact}`}>{d.nav.contact}</a>
      <a href={questionnairePath(locale)}>{d.nav.questionnaire}</a>
    </nav>

    <a
      class="booking-status"
      href={bookingHref}
      title={d.nav.bookingsOpen}
      aria-live="polite"
      data-booking-status
      data-locale={d.htmlLang}
      data-today-label={d.nav.bookingsToday}
      data-today-short={d.nav.bookingsTodayShort}
      data-next-label={d.nav.bookingsNext}
      data-next-short={d.nav.bookingsNextShort}
      data-none-label={d.nav.bookingsNone}
      data-none-short={d.nav.bookingsNoneShort}
    >
      <span class="booking-status__dot" aria-hidden="true"></span>
      <span class="booking-status__label">{d.nav.bookingsOpen}</span>
      <span class="booking-status__short">{d.nav.bookingsOpenShort}</span>
    </a>

    <div class="lang">
      <span class="visually-hidden">{d.nav.language}</span>
      {
        locales.map((l) =>
          l === locale ? (
            <span aria-current="true" title={localeNames[l]}>
              {l}
            </span>
          ) : alternates[l] ? (
            <a href={alternates[l]} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ) : (
            <a href={pathFor(l)} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ),
        )
      }
    </div>

    <a class="header-booking" href={bookingHref}>
      {d.service.bookCta}
    </a>
  </div>
</header>

<script>
  interface BookingStatusResponse {
    today: string;
    nextAvailableDate: string | null;
  }

  const status = document.querySelector<HTMLElement>('[data-booking-status]');

  if (status) {
    const label = status.querySelector<HTMLElement>('.booking-status__label');
    const shortLabel = status.querySelector<HTMLElement>('.booking-status__short');

    fetch('/api/booking-status', { headers: { Accept: 'application/json' } })
      .then((response) => {
        if (!response.ok) throw new Error('booking-status');
        return response.json() as Promise<BookingStatusResponse>;
      })
      .then(({ today, nextAvailableDate }) => {
        let fullText = status.dataset.noneLabel ?? '';
        let shortText = status.dataset.noneShort ?? fullText;
        status.dataset.availability = 'none';

        if (nextAvailableDate) {
          const formatter = new Intl.DateTimeFormat(status.dataset.locale ?? 'nl-NL', {
            weekday: 'long',
            timeZone: 'UTC',
          });
          const day = formatter.format(new Date(`${nextAvailableDate}T12:00:00Z`));
          if (nextAvailableDate === today) {
            fullText = status.dataset.todayLabel ?? fullText;
            shortText = status.dataset.todayShort ?? fullText;
            status.dataset.availability = 'today';
          } else {
            fullText = (status.dataset.nextLabel ?? '').replace('{day}', day);
            shortText = (status.dataset.nextShort ?? '{day}').replace('{day}', day);
            status.dataset.availability = 'future';
          }
        }

        if (label) label.textContent = fullText;
        if (shortLabel) shortLabel.textContent = shortText;
        status.title = fullText;
        status.setAttribute('aria-label', fullText);
      })
      .catch(() => {
        // Hiba eseten a stabil, altalanos foglalasi jelzes marad lathato.
      });
  }
</script>
