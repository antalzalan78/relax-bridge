---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import logoWordmark from '../assets/logo-wordmark.png';
import { bookingPath, site, locales, pathFor, localeNames, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const d = t(locale);
const home = pathFor(locale);
const bookingHref = bookingPath(locale);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={home}>
      {/* A nev mellette all, ezert a jel dekoraciokent ures alt-ot kap. */}
      <span class="brand__mark" aria-hidden="true">
        <Image
          class="brand__mark-image brand__mark-image--bridge"
          src={logoMark}
          alt=""
          width={70}
          loading="eager"
        />
        <svg
          class="brand__waves"
          viewBox="0 0 180 34"
          preserveAspectRatio="none"
          focusable="false"
          aria-hidden="true"
        >
          <g class="brand__wave-track brand__wave-track--back">
            <rect width="240" height="34" fill="transparent" />
            <path
              d="M0 10 C8 4 16 4 24 10 C32 16 40 16 48 10 C56 4 64 4 72 10 C80 16 88 16 96 10 C104 4 112 4 120 10 C128 16 136 16 144 10 C152 4 160 4 168 10 C176 16 184 16 192 10 C200 4 208 4 216 10 C224 16 232 16 240 10"
            />
          </g>
          <g class="brand__wave-track brand__wave-track--front">
            <rect width="240" height="34" fill="transparent" />
            <path
              d="M0 24 C10 17 20 17 30 24 C40 31 50 31 60 24 C70 17 80 17 90 24 C100 31 110 31 120 24 C130 17 140 17 150 24 C160 31 170 31 180 24 C190 17 200 17 210 24 C220 31 230 31 240 24"
            />
          </g>
        </svg>
      </span>
      <span class="brand__name">
        <Image
          class="brand__wordmark"
          src={logoWordmark}
          alt={site.name}
          width={190}
          loading="eager"
        />
      </span>
    </a>

    <nav class="nav" aria-label={d.nav.menu}>
      <a href={`${home}#${anchors.services}`}>{d.nav.studio}</a>
      <a href={`${home}#${anchors.prices}`}>{d.nav.prices}</a>
      <a href={`${home}#${anchors.contact}`}>{d.nav.contact}</a>
      <a href={site.giftCardUrl} rel="noopener">{d.nav.giftCard}</a>
    </nav>

    <a class="booking-status" href={bookingHref} title={d.nav.bookingsOpen}>
      <span class="booking-status__dot" aria-hidden="true"></span>
      <span class="booking-status__label">{d.nav.bookingsOpen}</span>
      <span class="booking-status__short">{d.nav.bookingsOpenShort}</span>
    </a>

    <div class="lang">
      <span class="visually-hidden">{d.nav.language}</span>
      {
        locales.map((l) =>
          l === locale ? (
            <span aria-current="true" title={localeNames[l]}>
              {l}
            </span>
          ) : alternates[l] ? (
            <a href={alternates[l]} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ) : (
            <a href={pathFor(l)} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ),
        )
      }
    </div>

    <a class="header-booking" href={bookingHref}>
      {d.service.bookCta}
    </a>
  </div>
</header>
