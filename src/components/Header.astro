---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import { site, locales, pathFor, localeNames, type Locale } from '../data/site';
import { anchors } from '../data/routes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const d = t(locale);
const home = pathFor(locale);
const bookingHref = site.bookingUrl ?? site.whatsapp;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={home}>
      {/* A nev mellette all, ezert a jel dekoraciokent ures alt-ot kap. */}
      <Image class="brand__mark" src={logoMark} alt="" width={70} loading="eager" />
      <span class="brand__name">
        Relax Bridge
        <small>Massage</small>
      </span>
    </a>

    <nav class="nav" aria-label={d.nav.menu}>
      <a href={`${home}#${anchors.services}`}>{d.nav.studio}</a>
      <a href={`${home}#${anchors.prices}`}>{d.nav.prices}</a>
      <a href={`${home}#${anchors.contact}`}>{d.nav.contact}</a>
      <a href={site.giftCardUrl} rel="noopener">{d.nav.giftCard}</a>
    </nav>

    <div class="lang">
      <span class="visually-hidden">{d.nav.language}</span>
      {
        locales.map((l) =>
          l === locale ? (
            <span aria-current="true" title={localeNames[l]}>
              {l}
            </span>
          ) : alternates[l] ? (
            <a href={alternates[l]} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ) : (
            <a href={pathFor(l)} hreflang={l} title={localeNames[l]}>
              {l}
            </a>
          ),
        )
      }
    </div>

    <a class="header-booking" href={bookingHref} rel="noopener">
      {d.service.bookCta}
    </a>
  </div>
</header>
