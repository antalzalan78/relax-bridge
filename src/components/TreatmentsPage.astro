---
import Base from '../layouts/Base.astro';
import { bookingPath, massageCreatorPath, treatmentsPath, type Locale } from '../data/site';
import { t } from '../i18n';
import { studioBookingText } from '../i18n/studio-booking';
import { getServices } from '../lib/services';

interface Props { locale: Locale }

const { locale } = Astro.props;
const d = t(locale);
const studioCopy = studioBookingText(locale);
const services = await getServices(locale, 'studio');
const path = treatmentsPath(locale);
const alternates = { nl: treatmentsPath('nl'), en: treatmentsPath('en'), hu: treatmentsPath('hu') };
const copy = {
  nl: {
    eyebrow: 'Vaste behandelingen, met persoonlijke aandacht',
    title: 'Losse massages',
    intro: 'Kies een behandeling en de duur; de details stemmen we op jou af. Tijdens het boeken kun je muziek en geur kiezen, of juist stilte en een geurvrije behandeling.',
    details: 'Meer over deze massage',
    book: 'Kies een tijdstip',
    creator: 'Liever combineren? Ontdek de Massage Creator',
  },
  en: {
    eyebrow: 'Ready-made treatments, with personal attention',
    title: 'Individual massages',
    intro: 'Choose a treatment and duration; we will tailor the details to you. When booking, you can choose music and scent, or silence and a scent-free treatment.',
    details: 'More about this massage',
    book: 'Choose an appointment time',
    creator: 'Prefer a combination? Explore the Massage Creator',
  },
  hu: {
    eyebrow: 'Kész kezelések, személyes figyelemmel',
    title: 'Önálló masszázsok',
    intro: 'Válassz kezelést és időtartamot, a részleteket hozzád igazítjuk. A foglalásnál zenét és illatot is választhatsz, vagy kérhetsz csendet és illatmentes kezelést.',
    details: 'További részletek a kezelésről',
    book: 'Időpont kiválasztása',
    creator: 'Inkább kombinálnál? Ismerd meg a Massage Creatort',
  },
}[locale];
---

<Base locale={locale} title={`${copy.title} — Relax Bridge`} description={copy.intro} path={path} alternates={alternates} quietBackdrop>
  <section class="wrap treatments-page">
    <header class="treatments-page__intro">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.intro}</p>
    </header>
    <div class="treatments-page__list">
      {services.map((service, index) => {
        const details = studioCopy.services[service.data.key as keyof typeof studioCopy.services];
        return <article class="treatments-page__card">
          <div class="treatments-page__body">
            <span class="eyebrow">{String(index + 1).padStart(2, '0')} · {copy.eyebrow}</span>
            <h2>{service.data.title}</h2>
            <p>{details?.headline || service.data.summary}</p>
            {details?.detail && <details><summary>{copy.details}</summary><p>{details.detail}</p></details>}
          </div>
          <div class="treatments-page__booking" aria-label={service.data.title}>
            <span class="treatments-page__price-label">{d.prices.duration} · {d.prices.price}</span>
            <div class="treatments-page__options">
            {service.data.prices.map((price, priceIndex) => <button type="button" aria-pressed={priceIndex === 0} data-booking-url={`${bookingPath(locale)}?service=${encodeURIComponent(`studio:${service.data.key}:${price.minutes}`)}&category=studio`}>
              <span>{price.minutes} {d.prices.minutes}</span>
              <strong>€ {price.eur}</strong>
            </button>)}
            </div>
            <a class="btn btn--primary treatments-page__book" href={`${bookingPath(locale)}?service=${encodeURIComponent(`studio:${service.data.key}:${service.data.prices[0].minutes}`)}&category=studio`}>{copy.book}<span aria-hidden="true">→</span></a>
          </div>
        </article>;
      })}
    </div>
    <a class="treatments-page__creator" href={massageCreatorPath(locale)}>{copy.creator} <span aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .treatments-page { max-width: 84rem; padding-block: clamp(2rem, 4vw, 3rem); }
  .treatments-page__intro { max-width: 59rem; margin-bottom: clamp(1.5rem, 3vw, 2.2rem); }
  .treatments-page__intro h1 { max-width: 23ch; margin-block: .35rem .9rem; font-size: clamp(2.5rem, 4.5vw, 4.2rem); }
  .treatments-page__intro p { max-width: 45rem; }
  .treatments-page__list { display: grid; gap: 1.1rem; }
  .treatments-page__card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; padding: clamp(1.3rem, 2.5vw, 2rem); border: 1px solid var(--border); border-radius: 1.5rem; background: var(--surface); box-shadow: 0 5px 16px rgb(73 59 27 / .05); }
  .treatments-page__body h2 { margin: .3rem 0 .75rem; font-size: clamp(1.8rem, 3vw, 2.2rem); }
  .treatments-page__body > p { max-width: 38rem; margin: 0; color: var(--pine-dark); font-weight: 650; }
  .treatments-page__body details { max-width: 38rem; margin-top: .8rem; color: var(--ink-soft); }
  .treatments-page__body summary { width: fit-content; color: var(--clay-dark); cursor: pointer; font-size: .9rem; font-weight: 700; }
  .treatments-page__body details p { margin: .5rem 0 0; }
  .treatments-page__booking { display: grid; gap: .75rem; }
  .treatments-page__price-label { color: var(--ink-soft); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .treatments-page__options { display: flex; gap: .55rem; }
  .treatments-page__options button { display: grid; flex: 1; gap: .15rem; min-width: 0; padding: .65rem .8rem; border: 1px solid #e8c69e; border-radius: .9rem; background: #f8e4d2; color: var(--ink); font: inherit; font-size: .84rem; line-height: 1.4; text-align: left; cursor: pointer; transition: background-color 180ms ease, transform 180ms ease; }
  .treatments-page__options button:nth-child(2) { border-color: #ddcde4; background: #eee4f1; }
  .treatments-page__options button[aria-pressed='true'] { border-color: #77965e; background: #e6edda; box-shadow: inset 0 0 0 1px rgb(119 150 94 / .2); }
  .treatments-page__options button:hover, .treatments-page__options button:focus-visible { transform: translateY(-2px); }
  .treatments-page__options button strong { font-size: 1.1rem; white-space: nowrap; }
  .treatments-page__book { justify-self: stretch; min-height: 2.9rem; }
  .treatments-page__creator { display: inline-flex; gap: .7rem; margin-top: 2rem; color: var(--pine-dark); font-weight: 700; }
  @media (max-width: 48rem) { .treatments-page__card { grid-template-columns: 1fr; gap: 1.25rem; } }
  @media (max-width: 38rem) {
    .treatments-page { padding-block: 1.5rem 2rem; }
    .treatments-page__intro { margin-bottom: 1.5rem; }
    .treatments-page__intro h1 { margin: .6rem 0 1rem; font-size: 2.3rem; line-height: 1.1; }
    .treatments-page__intro .lead { font-size: 1rem; line-height: 1.65; }
    .treatments-page__list { gap: .95rem; }
    .treatments-page__card { gap: 1.25rem; padding: 1.4rem 1.3rem; border-radius: 1.35rem; }
    .treatments-page__body .eyebrow { font-size: .6rem; }
    .treatments-page__body h2 { margin: .55rem 0 .8rem; font-size: 1.75rem; line-height: 1.15; overflow-wrap: anywhere; }
    .treatments-page__body > p { font-size: .95rem; line-height: 1.6; }
    .treatments-page__body details { margin-top: .75rem; }
    .treatments-page__body summary { min-height: 2.75rem; font-size: .82rem; }
    .treatments-page__booking { gap: .65rem; }
    .treatments-page__price-label { font-size: .625rem; }
    .treatments-page__options button { min-height: 3.25rem; }
    .treatments-page__book { min-height: 2.95rem; justify-content: center; font-size: .875rem; }
    .treatments-page__creator { line-height: 1.5; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.treatments-page__booking').forEach((booking) => {
    const bookLink = booking.querySelector<HTMLAnchorElement>('.treatments-page__book');
    booking.querySelectorAll<HTMLButtonElement>('.treatments-page__options button').forEach((option) => {
      option.addEventListener('click', () => {
        booking.querySelectorAll<HTMLButtonElement>('.treatments-page__options button').forEach((item) => item.setAttribute('aria-pressed', String(item === option)));
        if (bookLink && option.dataset.bookingUrl) bookLink.href = option.dataset.bookingUrl;
      });
    });
  });
</script>
