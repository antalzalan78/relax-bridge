---
import approvedLogoWatermark from '../assets/logo-watermark-approved.png';
---

<div
  class="site-logo-wallpaper"
  style={`--site-logo-pattern: url("${approvedLogoWatermark.src}")`}
  aria-hidden="true"
></div>

<style>
  .site-logo-wallpaper {
    position: absolute;
    z-index: 0;
    top: 4.75rem;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    background-image: var(--site-logo-pattern);
    background-repeat: repeat;
    background-position: 2rem 2.5rem;
    background-size: clamp(9.5rem, 12vw, 11.5rem) auto;
    mix-blend-mode: multiply;
    opacity: 0.032;
  }

  @media (max-width: 52rem) {
    .site-logo-wallpaper {
      top: 7.5rem;
      background-position: -1rem 1.5rem;
      background-size: 9.5rem auto;
      opacity: 0.028;
    }
  }
</style>
