---
import approvedLogoWatermark from '../assets/logo-watermark-approved.png';
---

<div
  class="site-logo-wallpaper"
  style={`--site-logo-pattern: url("${approvedLogoWatermark.src}")`}
  aria-hidden="true"
></div>

<style>
  .site-logo-wallpaper {
    --motif-size: clamp(9.5rem, 12vw, 11.5rem);
    --checker-size: clamp(19rem, 24vw, 23rem);

    position: absolute;
    z-index: 0;
    top: 4.75rem;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    background-image: var(--site-logo-pattern);
    background-repeat: repeat;
    background-position: 0 0;
    background-size: var(--motif-size) auto;
    -webkit-mask-image: conic-gradient(#000 0 25%, transparent 0 50%, #000 0 75%, transparent 0);
    mask-image: conic-gradient(#000 0 25%, transparent 0 50%, #000 0 75%, transparent 0);
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    -webkit-mask-size: var(--checker-size) var(--checker-size);
    mask-size: var(--checker-size) var(--checker-size);
    mix-blend-mode: multiply;
    opacity: 0.065;
  }

  @media (max-width: 52rem) {
    .site-logo-wallpaper {
      --motif-size: 9.5rem;
      --checker-size: 19rem;

      top: 7.5rem;
      opacity: 0.055;
    }
  }
</style>
