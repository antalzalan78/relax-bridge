---
import { Image } from 'astro:assets';
import approvedLogoWatermark from '../assets/logo-watermark-approved.png';
---

<div class="site-logo-wallpaper" aria-hidden="true">
  <Image
    class="site-logo-wallpaper__art"
    src={approvedLogoWatermark}
    alt=""
    width={1254}
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .site-logo-wallpaper {
    position: absolute;
    z-index: 0;
    top: 4.75rem;
    right: 0;
    left: 0;
    height: clamp(44rem, 74vw, 62rem);
    overflow: hidden;
    pointer-events: none;
    color: var(--logo-green);
  }

  .site-logo-wallpaper__art {
    position: absolute;
    top: -7.5rem;
    left: 50%;
    width: clamp(47rem, 79vw, 72rem);
    height: auto;
    mix-blend-mode: multiply;
    opacity: 0.065;
    transform: translateX(-50%);
  }

  @media (max-width: 52rem) {
    .site-logo-wallpaper {
      top: 4.25rem;
      height: 37rem;
    }

    .site-logo-wallpaper__art {
      top: -3rem;
      width: 43rem;
      opacity: 0.05;
    }
  }
</style>
