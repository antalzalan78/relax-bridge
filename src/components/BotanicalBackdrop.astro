---
import logoMark from '../assets/logo-mark.png';
---

<div class="site-logo-wallpaper" aria-hidden="true">
  <div
    class="site-logo-wallpaper__art"
    style={`--site-logo-mark: url("${logoMark.src}")`}
  ></div>
</div>

<style>
  .site-logo-wallpaper {
    position: absolute;
    z-index: 0;
    top: 4.75rem;
    right: 0;
    left: 0;
    height: clamp(44rem, 74vw, 62rem);
    overflow: hidden;
    pointer-events: none;
    color: var(--logo-green);
  }

  .site-logo-wallpaper__art {
    position: absolute;
    top: clamp(2.5rem, 5vw, 4.5rem);
    left: 50%;
    width: clamp(47rem, 79vw, 72rem);
    aspect-ratio: 747 / 423;
    background: currentColor;
    clip-path: polygon(0 0, 88% 0, 88% 14%, 100% 14%, 100% 100%, 0 100%);
    mask-image: var(--site-logo-mark);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    opacity: 0.052;
    transform: translateX(-50%);
  }

  @media (max-width: 52rem) {
    .site-logo-wallpaper {
      top: 4.25rem;
      height: 37rem;
    }

    .site-logo-wallpaper__art {
      top: 3rem;
      width: 43rem;
      opacity: 0.04;
    }
  }
</style>
