---
import { site, type Locale } from '../data/site';

interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const copy = {
  nl: {
    eyebrow: 'Persoonlijke ervaringen', title: 'Van mensen die hier al waren.',
    read: 'Lees meer beoordelingen op Google',
    quotes: [
      { name: 'Marilisa Pimentel', text: 'Ik hield van de muziek en van de manier waarop al mijn zintuigen werden aangesproken.', note: 'Google-beoordeling · vertaald fragment' },
      { name: 'Agustina', text: 'Ik heb een heerlijke massage gehad! Brigitta was heel professioneel en attent. Ze zorgde ervoor dat ik me tijdens de hele behandeling op mijn gemak en ontspannen voelde. Ik heb er echt van genoten en zou haar zeker aanbevelen!', note: 'Google-beoordeling · vertaald uit het Engels' },
    ],
  },
  en: {
    eyebrow: 'Personal experiences', title: 'From people who have been here.',
    read: 'Read more reviews on Google',
    quotes: [
      { name: 'Marilisa Pimentel', text: 'I loved the music and the way it engaged all my senses.', note: 'Google review · translated excerpt' },
      { name: 'Agustina', text: 'I had a wonderful massage experience! Brigitta was very professional, attentive, and made me feel comfortable and relaxed throughout the session. I really enjoyed it and would definitely recommend her!', note: 'Google review · original English' },
    ],
  },
  hu: {
    eyebrow: 'Személyes tapasztalatok', title: 'Akik már jártak nálam.',
    read: 'További vélemények a Google-on',
    quotes: [
      { name: 'Marilisa Pimentel', text: 'Imádtam a zenét és azt, ahogyan minden érzékemre hatott.', note: 'Google-vélemény · magyar fordítás, részlet' },
      { name: 'Agustina', text: 'Csodálatos masszázsélményben volt részem! Brigitta nagyon profi és figyelmes volt, és a kezelés alatt végig kényelmesen, ellazultan éreztem magam. Nagyon élveztem, és bátran ajánlom őt!', note: 'Google-vélemény · angolból fordítva' },
    ],
  },
}[locale];
---

<section class:list={['wrap', 'guest-reviews', { 'guest-reviews--compact': compact }]} aria-labelledby="guest-reviews-title">
  <span class="eyebrow">{copy.eyebrow}</span>
  <h2 id="guest-reviews-title">{copy.title}</h2>
  <div class="guest-reviews__grid">
    {copy.quotes.map((quote) => <figure class="guest-reviews__card">
      <span class="guest-reviews__stars" aria-label="5 / 5">★★★★★</span>
      <blockquote>“{quote.text}”</blockquote>
      <figcaption><strong>{quote.name}</strong><span>{quote.note}</span></figcaption>
    </figure>)}
  </div>
  <a class="guest-reviews__link" href={site.googleReviews} target="_blank" rel="noopener noreferrer">{copy.read} <span aria-hidden="true">↗</span></a>
</section>

<style>
  .guest-reviews { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .guest-reviews--compact { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .guest-reviews h2 { margin: .5rem 0 1.5rem; }
  .guest-reviews__grid { display: grid; gap: 1rem; }
  .guest-reviews__card { min-width: 0; margin: 0; padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .guest-reviews__stars { color: var(--clay); letter-spacing: .16em; }
  .guest-reviews blockquote { margin: .8rem 0 1.3rem; font-family: Georgia, serif; font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.5; }
  .guest-reviews figcaption { display: grid; gap: .15rem; font-size: .85rem; }
  .guest-reviews figcaption span { color: var(--ink-soft); }
  .guest-reviews__link { display: inline-flex; gap: .5rem; margin-top: 1.3rem; color: var(--pine-dark); font-weight: 700; }
  @media (min-width: 40rem) { .guest-reviews__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
