{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/booking-emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/google-calendar-sync",
      "schedule": "30 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/nl",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nl/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "en.relaxbridge.nl"
        }
      ],
      "destination": "https://relaxbridge.nl/en",
      "permanent": true
    },
    {
      "source": "/relaxmassage",
      "destination": "/massage/relaxmassage",
      "permanent": true
    },
    {
      "source": "/nek-schouder-rugmassage-1",
      "destination": "/massage/nek-schouder-rugmassage",
      "permanent": true
    },
    {
      "source": "/gezichtsmassage",
      "destination": "/massage/gezichtsmassage",
      "permanent": true
    },
    {
      "source": "/voetmassage",
      "destination": "/massage/voetmassage",
      "permanent": true
    },
    {
      "source": "/relaxmassage-2",
      "destination": "/massage/relaxmassage",
      "permanent": true
    },
    {
      "source": "/nek-schouder-rugmassage",
      "destination": "/massage/nek-schouder-rugmassage",
      "permanent": true
    },
    {
      "source": "/home-service/relaxmassage",
      "destination": "/massage/relaxmassage",
      "permanent": true
    },
    {
      "source": "/home-service/nek-schouder-rugmassage",
      "destination": "/massage/nek-schouder-rugmassage",
      "permanent": true
    },
    {
      "source": "/en/home-service/relax-massage",
      "destination": "/en/massage/relax-massage",
      "permanent": true
    },
    {
      "source": "/en/home-service/neck-shoulder-back-massage",
      "destination": "/en/massage/neck-shoulder-back-massage",
      "permanent": true
    },
    {
      "source": "/hu/hazhoz/relaxmasszazs",
      "destination": "/hu/masszazs/relaxmasszazs",
      "permanent": true
    },
    {
      "source": "/hu/hazhoz/nyak-vall-hatmasszazs",
      "destination": "/hu/masszazs/nyak-vall-hatmasszazs",
      "permanent": true
    },
    {
      "source": "/pages/cookie-policy",
      "destination": "/privacy#cookies",
      "permanent": true
    }
  ]
}
